<UserControl
    x:Class="BuildPc.Desktop.Views.PricingSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid RowDefinitions="Auto,*">
    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="30,20">
      <StackPanel Spacing="4">
        <TextBlock Text="Configurações" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="Defina o servidor de dados, margens e informações dos orçamentos."
                   Foreground="{DynamicResource Brush.TextBodyMuted}" FontSize="12" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="30,22,46,28"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Visible">
      <StackPanel>
        <Grid RowDefinitions="Auto"
              ColumnDefinitions="430,*"
              ColumnSpacing="18"
              MaxWidth="1120"
              HorizontalAlignment="Left">
        <StackPanel Spacing="18">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Aparência" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="Escolha como o programa deve acompanhar as cores do Windows."
                           Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10"
                           TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox ItemsSource="{Binding ThemeOptions}"
                        SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" FontSize="9"
                                 Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="A alteração é aplicada imediatamente. Use “Salvar configurações” para mantê-la."
                         FontSize="9" TextWrapping="Wrap"
                         Foreground="{DynamicResource Brush.TextMuted}" />
            </StackPanel>
          </Border>

          <Border Classes="card" DataContext="{Binding ServerSettings}">
            <StackPanel Spacing="13">
              <StackPanel Spacing="3">
                <TextBlock Text="Servidor de dados" FontSize="16" FontWeight="Bold" />
                <TextBlock
                    Text="Troque a VPS utilizada pelo BuildPC sem expor a senha do PostgreSQL."
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="10"
                    TextWrapping="Wrap" />
              </StackPanel>

              <Border
                  IsVisible="{Binding IsApiKeyUnreadable}"
                  Background="{DynamicResource Brush.WarningBackground}"
                  BorderBrush="{DynamicResource Brush.Warning}"
                  BorderThickness="1"
                  CornerRadius="7"
                  Padding="11,9">
                <TextBlock
                    Text="{Binding ApiKeyUnreadableMessage}"
                    TextWrapping="Wrap"
                    FontSize="10"
                    Foreground="{DynamicResource Brush.Warning}" />
              </Border>

              <CheckBox
                  IsChecked="{Binding UseServer, Mode=TwoWay}"
                  Content="Usar API em uma VPS" />

              <Border Classes="input-group" IsEnabled="{Binding UseServer}">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="5">
                    <TextBlock Text="Endereço da API" FontSize="10" />
                    <TextBox
                        Text="{Binding ServerUrl, Mode=TwoWay}"
                        PlaceholderText="https://servidor.exemplo/buildpc-api/" />
                    <TextBlock
                        Text="Use sempre HTTPS. Não informe aqui o endereço direto do PostgreSQL."
                        FontSize="9"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource Brush.TextMuted}" />
                  </StackPanel>

                  <StackPanel Spacing="5">
                    <TextBlock Text="Chave de acesso" FontSize="10" />
                    <Grid>
                      <TextBox
                          Text="{Binding ApiKey, Mode=TwoWay}"
                          PasswordChar="●"
                          IsVisible="{Binding HideApiKey}"
                          PlaceholderText="Chave fornecida pela API" />
                      <TextBox
                          Text="{Binding ApiKey, Mode=TwoWay}"
                          IsVisible="{Binding ShowApiKey}"
                          PlaceholderText="Chave fornecida pela API" />
                    </Grid>
                    <CheckBox
                        IsChecked="{Binding ShowApiKey, Mode=TwoWay}"
                        Content="Mostrar chave de acesso"
                        FontSize="10" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <TextBlock
                  IsVisible="{Binding UseLocalDatabase}"
                  Text="Ao salvar, o BuildPC voltará a usar o SQLite deste computador."
                  FontSize="9"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource Brush.TextMuted}" />

              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock
                    Text="{Binding StatusMessage}"
                    IsVisible="{Binding HasStatus}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{DynamicResource Brush.TextLabel}" />
                <Button
                    Grid.Column="1"
                    Classes="secondary"
                    Command="{Binding TestConnectionCommand}"
                    IsVisible="{Binding UseServer}">
                  <TextBlock Text="Testar conexão" />
                </Button>
                <Button
                    Grid.Column="2"
                    Classes="primary"
                    Command="{Binding SaveCommand}">
                  <TextBlock Text="Salvar acesso" Foreground="White" />
                </Button>
              </Grid>

              <TextBlock
                  Text="A alteração será usada depois que o programa for reiniciado."
                  FontSize="9"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource Brush.TextMuted}" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="14">
              <StackPanel Spacing="3">
                <TextBlock Text="Composição de preços" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="Categorias sem exceção usam automaticamente a margem global."
                           Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10"
                           TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="5">
                <TextBlock Text="Margem de lucro global (%)" FontSize="11"
                           Foreground="{DynamicResource Brush.TextLabel}" />
                <TextBlock Text="Mínimo obrigatório: 15%" FontSize="9"
                           Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBox Text="{Binding GlobalMarginText, Mode=TwoWay}"
                         PlaceholderText="Ex.: 25,00" />
              </StackPanel>
              <Border Classes="input-group">
                <StackPanel Spacing="10">
                  <TextBlock Text="Adicionar margem diferenciada" FontSize="12"
                             FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="*,110,Auto" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding AvailableCategories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Grid.Column="1" Text="{Binding NewMarginText, Mode=TwoWay}"
                             PlaceholderText="Margem %" />
                    <Button Grid.Column="2" Classes="primary"
                            Command="{Binding AddMarginCommand}">
                      <TextBlock Text="Adicionar" Foreground="White" />
                    </Button>
                  </Grid>
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding CategoryMargins}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="component-row" Margin="0,0,0,7" Padding="10">
                      <Grid ColumnDefinitions="*,110,40" ColumnSpacing="8">
                        <TextBlock Text="{Binding CategoryName}" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBox Grid.Column="1" Text="{Binding MarginText, Mode=TwoWay}"
                                 TextAlignment="Right" />
                        <Button Grid.Column="2" Classes="secondary"
                                Command="{Binding RemoveCommand}" Padding="7"
                                ToolTip.Tip="Usar novamente a margem global">
                          <PathIcon Data="{StaticResource Icon.Clear}" Width="14" Height="14"
                                    Foreground="{DynamicResource Brush.Error}" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="18">
          <Border Classes="card">
            <StackPanel Spacing="14">
              <StackPanel Spacing="3">
                <TextBlock Text="Dados da empresa no orçamento" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="Esses dados e a logomarca serão incluídos no PDF."
                           Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto">
                <StackPanel Spacing="5">
                  <TextBlock Text="Nome da empresa" FontSize="10" />
                  <TextBox Text="{Binding CompanyName, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="CPF / CNPJ" FontSize="10" />
                  <TextBox Text="{Binding CompanyDocument, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="5" Margin="0,10,0,0">
                  <TextBlock Text="Telefone" FontSize="10" />
                  <TextBox Text="{Binding CompanyPhone, Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                           MaxLength="15"
                           PlaceholderText="(00) 00000-0000" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5" Margin="0,10,0,0">
                  <TextBlock Text="E-mail" FontSize="10" />
                  <TextBox Text="{Binding CompanyEmail, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="5" Margin="0,10,0,0">
                  <TextBlock Text="Site" FontSize="10" />
                  <TextBox Text="{Binding CompanyWebsite, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5" Margin="0,10,0,0">
                  <TextBlock Text="Endereço" FontSize="10" />
                  <TextBox Text="{Binding CompanyAddress, Mode=TwoWay}" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="5">
                <TextBlock Text="Logomarca" FontSize="10" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding LogoPath, Mode=TwoWay}" IsReadOnly="True"
                           PlaceholderText="Selecione PNG ou JPEG" />
                  <Button Grid.Column="1" Classes="secondary" Click="BrowseLogo_Click">
                    <TextBlock Text="Selecionar imagem" />
                  </Button>
                </Grid>
              </StackPanel>
              <StackPanel Spacing="5">
                <TextBlock Text="Dados adicionais / condições do orçamento" FontSize="10" />
                <TextBox Text="{Binding AdditionalQuoteInfo, Mode=TwoWay}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="100"
                         PlaceholderText="Validade, formas de pagamento, garantia e observações..." />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                         Foreground="{DynamicResource Brush.TextLabel}"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="primary" Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource Icon.Save}" Width="16" Height="16"
                            Foreground="White" />
                  <TextBlock Text="Salvar configurações" Foreground="White" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </StackPanel>
        </Grid>
        <Border Classes="scroll-safe-area" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
