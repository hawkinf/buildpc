<UserControl
    x:Class="BuildPc.Desktop.Views.QuoteManagerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BuildPc.Desktop.Controls">

  <Grid RowDefinitions="Auto,*">
    <Border BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="30,14,46,14">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="Gerenciador de orçamentos" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Consulte os orçamentos gravados e gere novamente seus PDFs."
                       Foreground="{DynamicResource Brush.TextBodyMuted}" FontSize="12" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="secondary"
                  Click="Refresh_Click">
            <TextBlock Text="Atualizar lista" />
          </Button>
        </Grid>

        <Grid Grid.Row="1"
              DataContext="{Binding SelectedQuote}"
              ColumnDefinitions="*,*,*,*,Auto,Auto"
              ColumnSpacing="18">
          <StackPanel>
            <TextBlock Text="TOTAL"
                       FontSize="11.25"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="{Binding TotalText}"
                       FontSize="16.25"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.AccentLight}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="CUSTO"
                       FontSize="11.25"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="{Binding CostText}"
                       FontSize="16.25"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Error}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="LUCRO"
                       FontSize="11.25"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="{Binding ProfitText}"
                       FontSize="16.25"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Success}" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Text="% LUCRO"
                       FontSize="11.25"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="{Binding ProfitPercentText}"
                       FontSize="16.25"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Success}" />
          </StackPanel>
          <Button Grid.Column="4"
                  Classes="primary"
                  Click="ExportPdf_Click"
                  MinHeight="36"
                  Padding="12,8"
                  IsEnabled="{Binding $parent[UserControl].DataContext.HasSelection}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Pdf}" Width="16" Height="16"
                        Foreground="White" />
              <TextBlock Text="Exportar PDF" Foreground="White" />
            </StackPanel>
          </Button>
          <Button Grid.Column="5"
                  Classes="secondary"
                  Command="{Binding $parent[UserControl].DataContext.RequestDeleteCommand}"
                  IsEnabled="{Binding $parent[UserControl].DataContext.HasSelection}"
                  MinHeight="36"
                  MinWidth="36"
                  Padding="9,8"
                  ToolTip.Tip="Excluir o orçamento selecionado">
            <PathIcon Data="{StaticResource Icon.Clear}" Width="15" Height="15"
                      Foreground="{DynamicResource Brush.Error}" />
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            IsVisible="{Binding IsDeleteConfirmationVisible}"
            ZIndex="900"
            VerticalAlignment="Top"
            Margin="30,10,46,0"
            Background="{DynamicResource Brush.WarningBackground}"
            BorderBrush="{DynamicResource Brush.Warning}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,13">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBlock Text="{Binding DeleteConfirmationMessage}"
                   TextWrapping="Wrap"
                   FontSize="11"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Warning}" />
        <Button Grid.Column="1"
                Classes="secondary"
                Command="{Binding CancelDeleteCommand}">
          <TextBlock Text="Cancelar" />
        </Button>
        <Button Grid.Column="2"
                Classes="secondary"
                Command="{Binding ConfirmDeleteCommand}">
          <TextBlock Text="Sim, excluir"
                     Foreground="{DynamicResource Brush.Error}" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="390,*" ColumnSpacing="18" Margin="30,22,46,28">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="ORÇAMENTOS GRAVADOS" FontSize="10" FontWeight="Bold"
                     Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,12" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Quotes}"
                   SelectedItem="{Binding SelectedQuote, Mode=TwoWay}"
                   Padding="0,0,22,180">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Classes="catalog-row" Margin="0,0,0,6" Padding="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding NumberText}" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.AccentPale}" />
                      <TextBlock Text="{Binding ClientText}" FontSize="11" />
                      <TextBlock Text="{Binding DateText}" FontSize="9"
                                 Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="{Binding TotalText}" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.Warning}"
                                 TextAlignment="Right" />
                      <TextBlock Text="{Binding ItemsText}" FontSize="9"
                                 Foreground="{DynamicResource Brush.TextSecondary}"
                                 TextAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <Grid DataContext="{Binding SelectedQuote}" RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel>
            <TextBlock Text="{Binding NumberText}" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource Brush.TextSecondary}" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,18,0,14">
            <StackPanel>
              <TextBlock Text="CLIENTE" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock Text="{Binding ClientText}" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="TELEFONE" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock Text="{Binding PhoneText}" FontSize="14" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}"
                          Margin="0,0,36,180">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="savedQuoteProductRow"
                          Classes="component-row"
                          Classes.alternate="{Binding IsAlternate}"
                          Margin="0,0,0,7" Padding="10">
                    <Grid ColumnDefinitions="54,*,170">
                      <TextBlock Text="{Binding Quantity, StringFormat='{}{0}x'}"
                                 VerticalAlignment="Center" FontWeight="Bold" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CategoryName}" FontSize="9"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2"
                                  Spacing="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalPriceText}"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalCostText, StringFormat='Custo: {0}'}"
                                   TextAlignment="Right"
                                   FontSize="9"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                      </StackPanel>
                      <controls:ProductHoverPreview
                          Grid.ColumnSpan="3"
                          PlacementTarget="{Binding #savedQuoteProductRow}"
                          Title="{Binding Name}"
                          Description="{Binding Description}"
                          ImageUrl="{Binding ImageUrl}"
                          Price="{Binding TotalPriceText}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="3"
                     Text="{Binding $parent[UserControl].DataContext.StatusMessage}"
                     Margin="0,8,0,0"
                     FontSize="9"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.TextSecondary}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
