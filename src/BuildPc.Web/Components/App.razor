<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@BaseHref" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BuildPc.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // precos.hawk.com.br roda o app na raiz; loja.hawk.com.br/tabela roda o
    // MESMO processo sob um prefixo (app.UsePathBase("/tabela") no
    // Program.cs). Com o <base href> certo pro domínio de cada requisição,
    // todo link relativo do app (sem "/" na frente, ver MainLayout/NavLink
    // etc.) resolve certo nos dois -- sem isto, precisaria reescrever cada
    // link manualmente pra cada domínio.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string BaseHref => string.IsNullOrEmpty(HttpContext.Request.PathBase)
        ? "/"
        : $"{HttpContext.Request.PathBase}/";
}
