<Window
    x:Class="BuildPc.Desktop.Views.ProductEditWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BuildPc.Desktop.Controls"
    Title="Editar produto"
    Icon="/Assets/Brand/buildpc.ico"
    Width="680"
    Height="680"
    MinWidth="560"
    MinHeight="580"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Brush.AppBackground}">

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="24,18">
      <StackPanel Spacing="3">
        <TextBlock Text="Editar produto" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Altere os dados do produto selecionado no Catálogo Local."
                   Foreground="{DynamicResource Brush.TextBodyMuted}"
                   FontSize="11" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1"
                  Padding="24,20"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Text="Categoria *"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextLabel}" />
            <ComboBox ItemsSource="{Binding CategoryOptions}"
                      SelectedItem="{Binding SelectedProductCategory, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="Marca *"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextLabel}" />
            <TextBox Text="{Binding ProductBrand, Mode=TwoWay}"
                     PlaceholderText="Ex.: AMD" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="6">
          <TextBlock Text="Título do produto *"
                     FontSize="11"
                     Foreground="{DynamicResource Brush.TextLabel}" />
          <TextBox Text="{Binding ProductName, Mode=TwoWay}"
                   PlaceholderText="Ex.: Ryzen 7 7700" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Descrição *"
                     FontSize="11"
                     Foreground="{DynamicResource Brush.TextLabel}" />
          <TextBox Text="{Binding ProductDescription, Mode=TwoWay}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="88" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Text="Valor de venda"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextLabel}" />
            <TextBox Text="{Binding ProductSalePrice}"
                     IsReadOnly="True"
                     TextAlignment="Right"
                     FontWeight="SemiBold" />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="Custo *"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextLabel}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <Button x:Name="productCostEyeButton"
                      Classes="secondary"
                      MinWidth="44"
                      Padding="10"
                      ToolTip.Tip="Mantenha pressionado para revelar custo e lucro">
                <PathIcon Data="{StaticResource Icon.Eye}"
                          Width="17"
                          Height="17"
                          Foreground="{DynamicResource Brush.AccentLight}" />
              </Button>
              <TextBox Grid.Column="1"
                       Text="{Binding ProductPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PasswordChar="*"
                       IsVisible="{Binding IsProductEditCostHidden}"
                       PlaceholderText="********"
                       Padding="30,8,12,8"
                       TextAlignment="Right" />
              <TextBox Grid.Column="1"
                       Text="{Binding ProductPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       IsVisible="{Binding IsProductEditCostVisible}"
                       Padding="30,8,12,8"
                       TextAlignment="Right" />
              <TextBlock Grid.Column="1"
                         Text="R$"
                         Margin="10,0,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         FontSize="10"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
            </Grid>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Text="Lucro"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextLabel}" />
            <Grid>
              <TextBox Text="********"
                       IsReadOnly="True"
                       IsVisible="{Binding IsProductEditCostHidden}"
                       TextAlignment="Right" />
              <TextBox Text="{Binding ProductProfit}"
                       IsReadOnly="True"
                       IsVisible="{Binding IsProductEditCostVisible}"
                       TextAlignment="Right"
                       FontWeight="SemiBold" />
            </Grid>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="% de lucro"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextLabel}" />
            <Grid>
              <TextBox Text="********"
                       IsReadOnly="True"
                       IsVisible="{Binding IsProductEditCostHidden}"
                       TextAlignment="Right" />
              <TextBox Text="{Binding ProductProfitPercent}"
                       IsReadOnly="True"
                       IsVisible="{Binding IsProductEditCostVisible}"
                       TextAlignment="Right"
                       FontWeight="SemiBold" />
            </Grid>
          </StackPanel>
        </Grid>

        <Border Classes="input-group">
          <Grid ColumnDefinitions="96,*" ColumnSpacing="14">
            <Border Width="96"
                    Height="96"
                    CornerRadius="10"
                    Background="White">
              <Grid>
                <PathIcon Data="{StaticResource Icon.Products}"
                          Width="30"
                          Height="30"
                          Foreground="{DynamicResource Brush.TextMuted}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <controls:RemoteImage Url="{Binding ProductImagePath}"
                                      Stretch="Uniform"
                                      Margin="4" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1"
                        Spacing="8"
                        VerticalAlignment="Center">
              <TextBlock Text="Foto do produto"
                         FontSize="13"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding ProductImagePath}"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1"
                         FontSize="9"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
              <WrapPanel Orientation="Horizontal">
                <Button Classes="secondary"
                        Click="SelectProductImage_Click"
                        Margin="0,0,8,0">
                  <TextBlock Text="Adicionar / trocar foto" />
                </Button>
                <Button Classes="secondary"
                        Command="{Binding RemoveProductImageCommand}"
                        IsEnabled="{Binding HasProductImage}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.Clear}"
                              Width="13"
                              Height="13"
                              Foreground="{DynamicResource Brush.Error}" />
                    <TextBlock Text="Remover"
                               Foreground="{DynamicResource Brush.Error}" />
                  </StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Text="{Binding ProductFormMessage}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding IsProductFormError}"
                   Foreground="{DynamicResource Brush.Error}"
                   FontSize="11" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0"
            Padding="24,14">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBlock Text="Os campos com * são obrigatórios."
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   FontSize="10" />
        <Button Grid.Column="1"
                Classes="secondary"
                Click="Cancel_Click">
          <TextBlock Text="Cancelar" />
        </Button>
        <Button Grid.Column="2"
                Classes="primary"
                Click="Save_Click">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource Icon.Save}"
                      Width="16"
                      Height="16"
                      Foreground="White" />
            <TextBlock Text="Salvar alterações" Foreground="White" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
