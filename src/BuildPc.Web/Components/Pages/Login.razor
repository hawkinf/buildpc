@page "/login"
@attribute [AllowAnonymous]
@layout PublicLayout

<PageTitle>Entrar - Hawk Informática</PageTitle>

<div class="login-hero">
    <div class="login-blob login-blob-1"></div>
    <div class="login-blob login-blob-2"></div>

    <a href="/" class="login-back">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
        Hawk Informática
    </a>

    <form method="post" action="/account/login" class="login-card">
        <span class="login-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
        </span>
        <h1>Área da equipe</h1>
        <p class="login-tagline">Digite a senha da equipe para acessar custos, orçamentos e configurações.</p>
        <label for="password">Senha</label>
        <input type="password" id="password" name="password" autofocus required />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <button type="submit" class="login-submit">Entrar</button>
        <a href="/consulta" class="login-skip">Ver tabela de preços sem senha</a>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
}
