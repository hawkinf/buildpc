<UserControl
    x:Class="BuildPc.Desktop.Views.FlexibleListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BuildPc.Desktop.Controls"
    xmlns:vm="clr-namespace:BuildPc.Desktop.ViewModels"
    xmlns:models="clr-namespace:BuildPc.Core.Models;assembly=BuildPc.Core"
    x:CompileBindings="True"
    x:DataType="vm:FlexibleListViewModel">

  <Grid RowDefinitions="Auto,*,Auto">
    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="30,20">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="Montagem" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Escolha uma categoria e adicione quantos produtos precisar."
                     Foreground="{DynamicResource Brush.TextBodyMuted}"
                     FontSize="12"
                     TextWrapping="Wrap" />
        </StackPanel>
        <!--
          Cinco controles lado a lado passavam da largura disponível quando a
          janela se aproximava do mínimo, e os últimos ficavam cortados. O
          WrapPanel quebra para uma segunda linha em vez de cortar.
        -->
        <WrapPanel Grid.Column="1"
                   Orientation="Horizontal"
                   ItemSpacing="12"
                   LineSpacing="8"
                   VerticalAlignment="Center">
          <StackPanel MinWidth="112"
                      VerticalAlignment="Center">
            <TextBlock Text="PREÇO DE VENDA"
                       FontSize="8"
                       TextAlignment="Right"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <!-- Com desconto, o valor grande é o que o cliente paga; o total
                 dos itens aparece riscado acima para a conta ficar clara. -->
            <TextBlock Text="{Binding TotalPrice}"
                       IsVisible="{Binding HasDiscount}"
                       FontSize="10"
                       TextAlignment="Right"
                       TextDecorations="Strikethrough"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="{Binding FinalPrice}"
                       FontSize="16"
                       FontWeight="Bold"
                       TextAlignment="Right"
                       Foreground="{DynamicResource Brush.AccentLight}" />
          </StackPanel>

          <Button x:Name="sensitiveTotalsButton"
                  Classes="secondary"
                  Padding="10"
                  AutomationProperties.Name="Mantenha pressionado para ver custo e lucro"
                  ToolTip.Tip="Mantenha pressionado para ver custo e lucro">
            <PathIcon Data="{StaticResource Icon.Eye}" Width="18" Height="18"
                      Foreground="{DynamicResource Brush.AccentLight}" />
          </Button>

          <Button Classes="secondary"
                  Command="{Binding SaveQuoteCommand}"
                  IsEnabled="{Binding HasItems}"
                  AutomationProperties.Name="Gravar orçamento (Ctrl+S)"
                  ToolTip.Tip="Gravar orçamento (Ctrl+S)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Save}" Width="16" Height="16" />
              <TextBlock Text="Gravar orçamento" />
            </StackPanel>
          </Button>

          <CheckBox Content="Incluir descrição"
                    IsChecked="{Binding IncludeDescriptionsInPdf, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Incluir descrição no PDF exportado" />

          <Button Classes="primary"
                  Click="ExportPdf_Click"
                  IsEnabled="{Binding CanExport}"
                  AutomationProperties.Name="Exportar PDF (Ctrl+P)"
                  ToolTip.Tip="Exportar PDF (Ctrl+P)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Pdf}" Width="16" Height="16"
                        Foreground="White" />
              <TextBlock Text="Exportar PDF" Foreground="White" />
            </StackPanel>
          </Button>

          <Button Classes="secondary"
                  Command="{Binding RequestClearCommand}"
                  IsEnabled="{Binding HasItems}"
                  AutomationProperties.Name="Limpar montagem (Ctrl+L)"
                  ToolTip.Tip="Limpar montagem (Ctrl+L)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Clear}" Width="16" Height="16"
                        Foreground="{DynamicResource Brush.TextSecondary}" />
              <TextBlock Text="Limpar montagem" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  Padding="30,22,58,22"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Visible">
      <StackPanel Spacing="18" MinWidth="0" Margin="0,0,36,0">
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="15">
            <!-- A coluna de quantidade estava com 80px, estreita demais para o
                 NumericUpDown mostrar o número junto com as setas. -->
            <Grid ColumnDefinitions="170,*,110,112" ColumnSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Text="1. Categoria" FontSize="11"
                           Foreground="{DynamicResource Brush.TextLabel}" />
                <ComboBox ItemsSource="{Binding Categories}"
                          AutomationProperties.Name="Categoria do produto a adicionar"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryOptionViewModel">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="6" DataContext="{Binding ProductPicker}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="2. Produto" FontSize="11"
                             Foreground="{DynamicResource Brush.TextLabel}" />
                  <TextBlock Grid.Column="1" Text="{Binding $parent[UserControl].DataContext.CategoryProductsText}"
                             FontSize="9" Foreground="{DynamicResource Brush.TextMuted}"
                             VerticalAlignment="Center" />
                </Grid>
                <Grid>
                  <Button x:Name="flexibleProductSelector"
                          Classes="component-selector"
                          Height="44" MinHeight="44"
                          Command="{Binding TogglePickerCommand}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding SelectedOptionText}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <PathIcon Grid.Column="1" Data="{StaticResource Icon.ChevronDown}"
                                Width="16" Height="16" Margin="10,0,0,0"
                                Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Grid>
                  </Button>

                  <Popup IsOpen="{Binding IsPickerOpen, Mode=TwoWay}"
                         PlacementTarget="{Binding #flexibleProductSelector}"
                         Placement="Bottom"
                         IsLightDismissEnabled="True"
                         VerticalOffset="4">
                    <Border Classes="component-picker"
                            Width="{Binding #flexibleProductSelector.Bounds.Width}"
                            MinWidth="680">
                      <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="7">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                          <PathIcon Data="{StaticResource Icon.Filter}" Width="13" Height="13"
                                    Foreground="{DynamicResource Brush.AccentLight}"
                                    VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1"
                                     Text="FILTRAR • curingas: * e ? • excluir: -termo*"
                                     FontSize="9" FontWeight="Bold"
                                     Foreground="{DynamicResource Brush.TextMuted}"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding FilteredOptionsText}"
                                     FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Grid>
                        <TextBox Grid.Row="1"
                                 Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Digite para localizar o produto"
                                 MinHeight="34" Padding="10,5" />
                        <Border Grid.Row="2"
                                Background="{DynamicResource Brush.PanelBackground}"
                                CornerRadius="5" Padding="4,3">
                          <Grid ColumnDefinitions="*,135">
                            <Button Classes="list-header"
                                    Classes.active="{Binding IsNameSortActive}"
                                    Command="{Binding SortByNameCommand}"
                                    HorizontalContentAlignment="Left">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="DESCRIÇÃO" FontSize="9" FontWeight="Bold" />
                                <PathIcon Data="{Binding NameSortIcon, Converter={StaticResource IconResourceConverter}}"
                                          IsVisible="{Binding IsNameSortActive}"
                                          Width="13" Height="13" />
                              </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Classes="list-header"
                                    Classes.active="{Binding IsPriceSortActive}"
                                    Command="{Binding SortByPriceCommand}"
                                    HorizontalContentAlignment="Stretch">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Text="PREÇO" FontSize="9" FontWeight="Bold"
                                           HorizontalAlignment="Right" />
                                <PathIcon Grid.Column="1"
                                          Data="{Binding PriceSortIcon, Converter={StaticResource IconResourceConverter}}"
                                          IsVisible="{Binding IsPriceSortActive}"
                                          Width="13" Height="13" />
                              </Grid>
                            </Button>
                          </Grid>
                        </Border>
                        <ListBox Grid.Row="3" Classes="component-options"
                                 ItemsSource="{Binding Options}"
                                 SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                 MaxHeight="360">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ComponentOptionViewModel">
                              <Border x:Name="flexiblePickerProductRow"
                                      Classes="option-row"
                                      Classes.alternate="{Binding IsAlternate}"
                                      Margin="0,0,22,0">
                                <Grid ColumnDefinitions="Auto,*,135" ColumnSpacing="9">
                                  <Border Width="42" Height="42" CornerRadius="6"
                                          Background="White"
                                          IsVisible="{Binding HasImage}"
                                          VerticalAlignment="Center">
                                    <controls:RemoteImage Url="{Binding ImageUrl}"
                                                          Stretch="Uniform"
                                                          Margin="3" />
                                  </Border>
                                  <StackPanel Grid.Column="1" Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                      <PathIcon Data="{StaticResource Icon.StarFilled}"
                                                IsVisible="{Binding IsFavorite}"
                                                Width="10" Height="10"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource Brush.Warning}"
                                                ToolTip.Tip="Produto favorito" />
                                      <controls:HighlightedTextBlock
                                          SourceText="{Binding Name}"
                                          Query="{Binding FilterText}"
                                          HighlightForeground="{DynamicResource Brush.MatchForeground}"
                                          HighlightBackground="{DynamicResource Brush.MatchBackground}"
                                          FontSize="12" FontWeight="SemiBold"
                                          Foreground="{DynamicResource Brush.AccentPale}"
                                          TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Brand}" FontSize="9"
                                               Foreground="{DynamicResource Brush.TextBody}" />
                                    <controls:HighlightedTextBlock
                                        SourceText="{Binding Description}"
                                        Query="{Binding FilterText}"
                                        HighlightForeground="{DynamicResource Brush.MatchForeground}"
                                        HighlightBackground="{DynamicResource Brush.MatchBackground}"
                                        FontSize="10"
                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                        TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                   <TextBlock Grid.Column="2"
                                              Text="{Binding Price, StringFormat='R$ {0:N2}'}"
                                             FontSize="11" Foreground="{DynamicResource Brush.Warning}"
                                             FontWeight="SemiBold" VerticalAlignment="Center"
                                              Margin="10,0,0,0" TextAlignment="Right" />
                                  <controls:ProductHoverPreview
                                      Grid.ColumnSpan="3"
                                      PlacementTarget="{Binding #flexiblePickerProductRow}"
                                      Title="{Binding Name}"
                                      Description="{Binding Description}"
                                      ImageUrl="{Binding ImageUrl}"
                                      Price="{Binding DisplayPrice}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                    </Border>
                  </Popup>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="Quantidade" FontSize="11"
                           Foreground="{DynamicResource Brush.TextLabel}" />
                <NumericUpDown Classes="quantity-selector"
                               Height="44" MinHeight="44"
                               Value="{Binding Quantity, Mode=TwoWay}"
                               Minimum="1" Maximum="9999"
                               Increment="1"
                               FormatString="0"
                               ParsingNumberStyle="Integer"
                               ShowButtonSpinner="True" />
              </StackPanel>

              <Button Grid.Column="3" Classes="primary"
                      Command="{Binding AddCommand}"
                      IsEnabled="{Binding CanAdd}"
                      VerticalAlignment="Bottom"
                      Height="44" MinHeight="44">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource Icon.Add}" Width="17" Height="17"
                            Foreground="White" />
                  <TextBlock Text="Adicionar" Foreground="White" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <Grid ColumnDefinitions="*,230,1.2*" ColumnSpacing="12">
            <StackPanel Spacing="5">
              <TextBlock Text="Nome do cliente *" FontSize="10"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <TextBox Text="{Binding ClientName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Classes.invalid="{Binding IsClientNameInvalid}"
                       AutomationProperties.Name="Nome do cliente, obrigatório"
                       PlaceholderText="Nome para o orçamento" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="Telefone *" FontSize="10"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <TextBox Text="{Binding ClientPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Classes.invalid="{Binding IsClientPhoneInvalid}"
                       MaxLength="15"
                       AutomationProperties.Name="Telefone do cliente, obrigatório"
                       PlaceholderText="(00) 00000-0000" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock Text="Observações deste orçamento" FontSize="10"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Observações deste orçamento"
                       PlaceholderText="Informações específicas para este cliente" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Condições comerciais: desconto, validade, pagamento e entrega. -->
        <Border Classes="card" IsVisible="{Binding HasItems}">
          <Grid ColumnDefinitions="180,150,1.1*,1.1*" ColumnSpacing="12">
            <StackPanel Spacing="5">
              <TextBlock Text="Desconto (R$)" FontSize="10"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <Grid>
                <TextBox Text="{Binding DiscountText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Padding="30,8,12,8"
                         TextAlignment="Right"
                         AutomationProperties.Name="Desconto em reais"
                         PlaceholderText="0,00" />
                <TextBlock Text="R$" Margin="12,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           IsHitTestVisible="False" />
              </Grid>
              <TextBlock Text="{Binding FinalPrice, StringFormat='Cliente paga: {0}'}"
                         IsVisible="{Binding HasDiscount}"
                         FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Success}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="Validade (dias)" FontSize="10"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <NumericUpDown Value="{Binding ValidityDays, Mode=TwoWay}"
                             AutomationProperties.Name="Validade da proposta em dias, zero para sem prazo"
                             Minimum="0" Maximum="365"
                             Increment="1"
                             FormatString="0"
                             ParsingNumberStyle="Integer"
                             ShowButtonSpinner="True" />
              <TextBlock Text="0 = sem prazo" FontSize="9"
                         Foreground="{DynamicResource Brush.TextMuted}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock Text="Condições de pagamento" FontSize="10"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <TextBox Text="{Binding PaymentTerms, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Condições de pagamento"
                       PlaceholderText="Ex.: 3x sem juros no cartão" />
            </StackPanel>

            <StackPanel Grid.Column="3" Spacing="5">
              <TextBlock Text="Prazo de entrega" FontSize="10"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <TextBox Text="{Binding DeliveryTerms, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Prazo de entrega"
                       PlaceholderText="Ex.: 5 dias úteis" />
            </StackPanel>
          </Grid>
        </Border>

        <!--
          Modelos de montagem: combinações mais vendidas reaproveitadas. Guardam
          só produto e quantidade, então os preços vêm do catálogo atual.
        -->
        <Expander Header="Modelos de montagem"
                  DataContext="{Binding Templates}"
                  AutomationProperties.Name="Modelos de montagem reutilizáveis">
          <Grid ColumnDefinitions="1.2*,*" ColumnSpacing="16" Margin="0,10,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="MODELOS SALVOS" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock Text="Nenhum modelo salvo ainda."
                         IsVisible="{Binding IsEmpty}"
                         FontSize="11"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
              <ListBox ItemsSource="{Binding Templates}"
                       SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                       IsVisible="{Binding HasTemplates}"
                       AutomationProperties.Name="Modelos salvos"
                       MaxHeight="170"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssemblyTemplateItemViewModel">
                    <StackPanel Spacing="1" Margin="0,2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                 FontSize="11" />
                      <TextBlock Text="{Binding Description}"
                                 IsVisible="{Binding HasDescription}"
                                 FontSize="9"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource Brush.TextSecondary}" />
                      <TextBlock Text="{Binding QuantityText}" FontSize="9"
                                 Foreground="{DynamicResource Brush.TextMuted}" />
                      <TextBlock Text="{Binding KitDiscountText}"
                                 IsVisible="{Binding HasKitDiscount}"
                                 FontSize="9"
                                 Foreground="{DynamicResource Brush.Warning}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary"
                        Command="{Binding ApplyCommand}"
                        IsEnabled="{Binding HasSelection}"
                        AutomationProperties.Name="Aplicar o modelo selecionado à montagem"
                        ToolTip.Tip="Substitui a montagem pelos itens do modelo, com os preços atuais">
                  <TextBlock Text="Aplicar modelo" Foreground="White" />
                </Button>
                <Button Classes="secondary"
                        Command="{Binding RequestDeleteCommand}"
                        IsEnabled="{Binding HasSelection}"
                        MinWidth="36" Padding="9,8"
                        AutomationProperties.Name="Excluir o modelo selecionado"
                        ToolTip.Tip="Excluir o modelo selecionado">
                  <PathIcon Data="{StaticResource Icon.Clear}" Width="14" Height="14"
                            Foreground="{DynamicResource Brush.Error}" />
                </Button>
              </StackPanel>

              <Border IsVisible="{Binding IsDeleteConfirmationVisible}"
                      Background="{DynamicResource Brush.WarningBackground}"
                      BorderBrush="{DynamicResource Brush.Warning}"
                      BorderThickness="1" CornerRadius="7" Padding="11,9">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding DeleteConfirmationMessage}"
                             TextWrapping="Wrap" FontSize="10"
                             Foreground="{DynamicResource Brush.Warning}" />
                  <StackPanel Orientation="Horizontal" Spacing="8"
                              HorizontalAlignment="Right">
                    <Button Classes="secondary" Command="{Binding CancelDeleteCommand}">
                      <TextBlock Text="Cancelar" />
                    </Button>
                    <Button Classes="secondary" Command="{Binding ConfirmDeleteCommand}">
                      <TextBlock Text="Sim, excluir"
                                 Foreground="{DynamicResource Brush.Error}" />
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="SALVAR A MONTAGEM ATUAL COMO MODELO"
                         FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBox Text="{Binding NewTemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Nome do novo modelo"
                       PlaceholderText="Ex.: PC Gamer básico" />
              <TextBox Text="{Binding NewTemplateDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Descrição do novo modelo"
                       PlaceholderText="Descrição opcional" />
              <TextBox Text="{Binding NewTemplateKitDiscountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Desconto sugerido do kit, em percentual"
                       ToolTip.Tip="Aplicado como desconto ao orçamento quando o modelo for usado"
                       PlaceholderText="Desconto sugerido do kit (%), opcional" />
              <Button Classes="secondary"
                      Command="{Binding SaveCommand}"
                      IsEnabled="{Binding CanSave}"
                      HorizontalAlignment="Left"
                      AutomationProperties.Name="Salvar a montagem atual como modelo"
                      ToolTip.Tip="Guarda os produtos e as quantidades da montagem atual">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource Icon.Save}" Width="15" Height="15" />
                  <TextBlock Text="Salvar como modelo" />
                </StackPanel>
              </Button>
              <TextBlock Text="{Binding StatusMessage}"
                         IsVisible="{Binding HasStatus}"
                         TextWrapping="Wrap" FontSize="10"
                         Foreground="{DynamicResource Brush.TextLabel}" />
            </StackPanel>
          </Grid>
        </Expander>

        <!--
          O serviço de compatibilidade (soquete, memória, fonte) já existia
          testado, mas nenhuma tela o usava até agora.
        -->
        <Border Classes="card"
                IsVisible="{Binding HasCompatibilityIssues}"
                Padding="14,10">
          <ItemsControl ItemsSource="{Binding CompatibilityIssues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:CompatibilityIssue">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                  <PathIcon Data="{StaticResource Icon.Warning}"
                            Width="13" Height="13"
                            VerticalAlignment="Top"
                            Foreground="{Binding Severity,
                                Converter={StaticResource IssueSeverityBrushConverter}}" />
                  <TextBlock Text="{Binding Message}"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Foreground="{Binding Severity,
                                 Converter={StaticResource IssueSeverityBrushConverter}}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsEmpty}" Padding="28">
          <StackPanel HorizontalAlignment="Center" Spacing="8">
            <PathIcon Data="{StaticResource Icon.FlexibleList}" Width="34" Height="34"
                      Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="Sua montagem ainda está vazia" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Selecione uma categoria e um produto acima para começar."
                       Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FlexibleListItemViewModel">
              <Border x:Name="flexibleSelectedProductRow"
                      Classes="component-row" Classes.alternate="{Binding IsAlternate}"
                      Margin="0,0,0,8">
                <!--
                  Foto, ordem e lixeira tem largura fixa porque sao icones.
                  Categoria, quantidade e valor passaram a ter minimo e
                  proporcao, para cederem espaco a titulo e descricao quando a
                  janela encolhe em vez de cortar o texto.
                -->
                <Grid ColumnDefinitions="84,0.7*,1.3*,1.2*,0.6*,1.1*,28,44"
                      ColumnSpacing="10"
                      MinWidth="0">
                  <Border Classes="product-image"
                          Classes.has-image="{Binding HasImage}"
                          ZIndex="10"
                          Width="76" Height="76" CornerRadius="10"
                          Background="{DynamicResource Brush.AccentSurface}">
                    <Grid>
                      <PathIcon Data="{Binding Icon, Converter={StaticResource IconResourceConverter}}"
                                Width="28" Height="28"
                                Foreground="{DynamicResource Brush.AccentPale}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <controls:RemoteImage Url="{Binding ImageUrl}"
                                            Stretch="Uniform"
                                            Margin="5" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                              MinWidth="84">
                    <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.AccentPale}" />
                    <TextBlock Text="{Binding Brand}" FontSize="9"
                               Foreground="{DynamicResource Brush.TextBody}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2" Spacing="4" MinWidth="0">
                    <TextBlock Text="Título" FontSize="9"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="58" MaxHeight="58"
                             MinWidth="0"
                             Padding="9,6" FontSize="11" />
                  </StackPanel>

                  <StackPanel Grid.Column="3" Spacing="4" MinWidth="0">
                    <TextBlock Text="Descrição" FontSize="9"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="58" MaxHeight="58"
                             MinWidth="0"
                             Padding="9,6" FontSize="10" />
                  </StackPanel>

                  <StackPanel Grid.Column="4" Spacing="4">
                    <TextBlock Text="Quantidade" FontSize="9"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                    <NumericUpDown Classes="quantity-selector"
                                   Value="{Binding Quantity, Mode=TwoWay}"
                                   Minimum="1" Maximum="9999"
                                   Increment="1"
                                   FormatString="0"
                                   ParsingNumberStyle="Integer"
                                   ShowButtonSpinner="True" />
                  </StackPanel>

                  <StackPanel Grid.Column="5" Spacing="4">
                    <TextBlock Text="Valor de venda" FontSize="9"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                    <Grid>
                      <TextBox Text="{Binding SellingPriceText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Padding="30,5,9,5" MinHeight="36" Height="36"
                               FontSize="11" TextAlignment="Right" />
                      <TextBlock Text="R$" Margin="10,0,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}"
                                 IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Text="{Binding CostUnitPrice}"
                               IsVisible="{Binding IsCostVisible}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Warning}"
                               TextAlignment="Right" />
                  </StackPanel>

                  <!-- A ordem das linhas e a ordem dos itens no PDF do cliente. -->
                  <StackPanel Grid.Column="6" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="list-header"
                            Command="{Binding MoveUpCommand}"
                            IsEnabled="{Binding CanMoveUp}"
                            Padding="3" MinWidth="22" MinHeight="20"
                            AutomationProperties.Name="Mover este item uma posição para cima"
                            ToolTip.Tip="Mover para cima">
                      <PathIcon Data="{StaticResource Icon.MoveUp}" Width="11" Height="11"
                                Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Button>
                    <Button Classes="list-header"
                            Command="{Binding MoveDownCommand}"
                            IsEnabled="{Binding CanMoveDown}"
                            Padding="3" MinWidth="22" MinHeight="20"
                            AutomationProperties.Name="Mover este item uma posição para baixo"
                            ToolTip.Tip="Mover para baixo">
                      <PathIcon Data="{StaticResource Icon.MoveDown}" Width="11" Height="11"
                                Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Button>
                  </StackPanel>

                  <Button Grid.Column="7" Classes="secondary"
                          Command="{Binding RemoveCommand}"
                          Padding="8" MinWidth="36"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Remover produto"
                          ToolTip.Tip="Remover produto">
                    <PathIcon Data="{StaticResource Icon.Clear}" Width="15" Height="15"
                              Foreground="{DynamicResource Brush.Error}" />
                  </Button>
                  <controls:ProductHoverPreview
                      Grid.ColumnSpan="8"
                      PlacementTarget="{Binding #flexibleSelectedProductRow}"
                      Title="{Binding Name}"
                      Description="{Binding Description}"
                      ImageUrl="{Binding ImageUrl}"
                      Price="{Binding SellingUnitPrice}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="scroll-safe-area"
                IsVisible="{Binding HasItems}" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource Brush.SidebarBackground}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
            Padding="30,8,46,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding SaveStateText}" FontSize="10"
                     Foreground="{DynamicResource Brush.TextSecondary}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="10"
                     Foreground="{DynamicResource Brush.TextLabel}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsSensitiveTotalsVisible}">
          <StackPanel>
            <TextBlock Text="CUSTO" FontSize="8" Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="{Binding TotalCost}" FontWeight="Bold" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="LUCRO" FontSize="8" Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="{Binding TotalProfit}" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Success}" />
            <TextBlock Text="{Binding TotalProfitPercent}" FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Success}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Confirmação destrutiva de "Limpar montagem". -->
    <Grid Grid.RowSpan="3"
          ZIndex="1000"
          Background="#A6000000"
          IsVisible="{Binding IsClearConfirmationVisible}">
      <Border Classes="card"
              MaxWidth="470"
              Padding="24"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <PathIcon Data="{StaticResource Icon.Warning}" Width="20" Height="20"
                      Foreground="{DynamicResource Brush.Warning}"
                      VerticalAlignment="Center" />
            <TextBlock Text="Limpar montagem"
                       FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding ClearConfirmationMessage}"
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="{DynamicResource Brush.TextBody}" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Button Grid.Column="1"
                    Classes="secondary"
                    Command="{Binding CancelClearCommand}">
              <TextBlock Text="Cancelar" />
            </Button>
            <Button Grid.Column="2"
                    Classes="secondary"
                    Command="{Binding ConfirmClearCommand}">
              <TextBlock Text="Sim, limpar"
                         Foreground="{DynamicResource Brush.Error}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
