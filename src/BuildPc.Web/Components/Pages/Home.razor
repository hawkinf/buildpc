@page "/"
@inject NavigationManager NavigationManager

@code {
    // Montagem é a tela mais usada no dia a dia — decisão de rota deixada em
    // aberto no plano até as três telas existirem, resolvida agora que a
    // fase 7 fechou o conjunto (Montagem/Consulta de Preços/Orçamentos).
    protected override void OnInitialized() =>
        NavigationManager.NavigateTo("/montagem", forceLoad: true);
}
