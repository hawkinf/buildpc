<UserControl
    x:Class="BuildPc.Desktop.Views.PriceLookupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BuildPc.Desktop.Controls">

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="30,20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="Consultar preço"
                     FontSize="22"
                     FontWeight="Bold" />
          <TextBlock Text="Selecione uma categoria e consulte os preços de custo ou venda."
                     Foreground="{DynamicResource Brush.TextBodyMuted}"
                     FontSize="12" />
        </StackPanel>
        <Border Grid.Column="1"
                Background="{DynamicResource Brush.AccentSurface}"
                CornerRadius="8"
                Padding="12,7"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding CountText}"
                     Foreground="{DynamicResource Brush.AccentBadge}"
                     FontSize="11"
                     FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Classes="card"
            Margin="30,22"
            Padding="0">
      <Grid RowDefinitions="Auto,Auto,*">
        <Border BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
          <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Categoria"
                         FontSize="9"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <ComboBox ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                        MinHeight="38"
                        Height="38"
                        Padding="10,5">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Filtro"
                         FontSize="9"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="Palavras-chave: nvme 256 adata"
                       MinHeight="38"
                       Height="38"
                       Padding="10,5" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="Exibir"
                         FontSize="9"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <Border Background="{DynamicResource Brush.PanelBackground}"
                      CornerRadius="7"
                      Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Classes="price-mode"
                          Classes.active="{Binding IsCostActive}"
                          Command="{Binding ShowCostCommand}">
                    <TextBlock Text="Custo" />
                  </Button>
                  <Button Classes="price-mode"
                          Classes.active="{Binding IsSaleActive}"
                          Command="{Binding ShowSaleCommand}">
                    <TextBlock Text="Venda" />
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.PanelBackground}"
                Padding="18,4">
          <Grid ColumnDefinitions="64,*,180" ColumnSpacing="12">
            <Button Grid.Column="1"
                    Classes="list-header"
                    Classes.active="{Binding IsTitleSortActive}"
                    Command="{Binding SortByTitleCommand}"
                    HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="TÍTULO"
                           FontSize="9"
                           FontWeight="Bold" />
                <PathIcon Data="{Binding TitleSortIcon,
                                        Converter={StaticResource IconResourceConverter}}"
                          IsVisible="{Binding IsTitleSortActive}"
                          Width="12"
                          Height="12" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2"
                    Classes="list-header"
                    Classes.active="{Binding IsPriceSortActive}"
                    Command="{Binding SortByPriceCommand}"
                    HorizontalContentAlignment="Right">
              <StackPanel Orientation="Horizontal"
                          Spacing="6"
                          HorizontalAlignment="Right">
                <TextBlock Text="{Binding PriceColumnTitle}"
                           FontSize="9"
                           FontWeight="Bold" />
                <PathIcon Data="{Binding PriceSortIcon,
                                        Converter={StaticResource IconResourceConverter}}"
                          IsVisible="{Binding IsPriceSortActive}"
                          Width="12"
                          Height="12" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Items}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="12,8,30,180"
                 SelectionMode="Single">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,4" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Background" Value="Transparent" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border x:Name="lookupProductRow"
                      Classes="catalog-row"
                      Classes.alternate="{Binding IsAlternate}"
                      Padding="12,8">
                <Grid>
                  <Grid ColumnDefinitions="52,*,180" ColumnSpacing="12">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="7"
                            Background="White"
                            IsVisible="{Binding HasImage}">
                      <controls:RemoteImage Url="{Binding ImageUrl}"
                                            Stretch="Uniform"
                                            Margin="3" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Spacing="4"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.AccentPale}"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="1" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Brand}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.TextBody}" />
                        <Border Background="{DynamicResource Brush.BadgeBackground}"
                                CornerRadius="5"
                                Padding="6,2">
                          <TextBlock Text="{Binding Category}"
                                     FontSize="9"
                                     Foreground="{DynamicResource Brush.AccentPale}" />
                        </Border>
                      </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding DisplayPrice}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Warning}" />
                  </Grid>

                  <controls:ProductHoverPreview
                      PlacementTarget="{Binding #lookupProductRow}"
                      Title="{Binding Name}"
                      Description="{Binding Description}"
                      ImageUrl="{Binding ImageUrl}"
                      Price="{Binding DisplayPrice}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
