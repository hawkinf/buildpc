@inherits LayoutComponentBase

<div class="app">
    <header class="app-header">
        <span class="app-brand">Hawk Informática</span>
        <AuthorizeView>
            <Authorized>
                <nav class="app-nav">
                    <NavLink href="/montagem">Montagem</NavLink>
                    <NavLink href="/precos">Consulta de Preços</NavLink>
                    <NavLink href="/orcamentos">Orçamentos</NavLink>
                    <NavLink href="/importacoes">Importações</NavLink>
                </nav>
                <form method="post" action="/account/logout" class="app-logout">
                    <button type="submit">Sair</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="app-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>
