<Window
    x:Class="BuildPc.Desktop.Views.ProductEditWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BuildPc.Desktop.Controls"
    Title="Editar produto"
    Icon="/Assets/Brand/buildpc.ico"
    Width="680"
    Height="590"
    MinWidth="580"
    MinHeight="520"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Brush.AppBackground}">

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="20,14">
      <StackPanel Spacing="2">
        <TextBlock Text="Editar produto" FontSize="19" FontWeight="Bold" />
        <TextBlock Text="Altere os dados do produto selecionado no Catálogo Local."
                   Foreground="{DynamicResource Brush.TextBodyMuted}"
                   FontSize="10" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1"
                  Padding="20,14"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="11">
        <Grid ColumnDefinitions="*,142,*" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Top">
            <TextBlock Text="Categoria *"
                       FontSize="10"
                       Foreground="{DynamicResource Brush.TextLabel}" />
            <ComboBox ItemsSource="{Binding CategoryOptions}"
                      SelectedItem="{Binding SelectedProductCategory, Mode=TwoWay}"
                      MinHeight="38"
                      Height="38"
                      Padding="10,5">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <Grid Grid.Column="1"
                ColumnDefinitions="104,Auto"
                ColumnSpacing="5"
                HorizontalAlignment="Center">
            <Border Classes="edit-product-image"
                    Classes.has-image="{Binding HasProductImage}"
                    Width="104"
                    Height="104"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource Brush.InputBorder}"
                    BorderThickness="1"
                    Background="White">
              <Grid>
                <PathIcon Data="{StaticResource Icon.Products}"
                          Width="25"
                          Height="25"
                          Foreground="{DynamicResource Brush.TextMuted}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <controls:RemoteImage Url="{Binding ProductImagePath}"
                                      Stretch="Uniform"
                                      Margin="4" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1"
                        Spacing="5"
                        VerticalAlignment="Center">
              <Button Classes="secondary"
                      Click="SelectProductImage_Click"
                      Width="28"
                      MinWidth="28"
                      Height="28"
                      MinHeight="28"
                      Padding="6"
                      ToolTip.Tip="Adicionar ou trocar a foto">
                <PathIcon Data="{StaticResource Icon.Add}"
                          Width="13"
                          Height="13"
                          Foreground="{DynamicResource Brush.AccentLight}" />
              </Button>
              <Button Classes="secondary"
                      Command="{Binding RemoveProductImageCommand}"
                      IsEnabled="{Binding HasProductImage}"
                      Width="28"
                      MinWidth="28"
                      Height="28"
                      MinHeight="28"
                      Padding="6"
                      ToolTip.Tip="Remover a foto">
                <PathIcon Data="{StaticResource Icon.Clear}"
                          Width="12"
                          Height="12"
                          Foreground="{DynamicResource Brush.Error}" />
              </Button>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Top">
            <TextBlock Text="Marca *"
                       FontSize="10"
                       Foreground="{DynamicResource Brush.TextLabel}" />
            <TextBox Text="{Binding ProductBrand, Mode=TwoWay}"
                     PlaceholderText="Ex.: AMD"
                     MinHeight="38"
                     Height="38"
                     Padding="10,5" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="5">
          <TextBlock Text="Título do produto *"
                     FontSize="10"
                     Foreground="{DynamicResource Brush.TextLabel}" />
          <TextBox Text="{Binding ProductName, Mode=TwoWay}"
                   PlaceholderText="Ex.: Ryzen 7 7700"
                   MinHeight="38"
                   Height="38"
                   Padding="10,5" />
        </StackPanel>

        <StackPanel Spacing="5">
          <TextBlock Text="Descrição *"
                     FontSize="10"
                     Foreground="{DynamicResource Brush.TextLabel}" />
          <TextBox Text="{Binding ProductDescription, Mode=TwoWay}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="62"
                   Height="62"
                   Padding="10,7" />
        </StackPanel>

        <Border Classes="input-group" Padding="10,8">
          <Grid ColumnDefinitions="*,1.35*,*,*" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="Valor de venda"
                         FontSize="9"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <Border Height="34"
                      CornerRadius="7"
                      BorderBrush="{DynamicResource Brush.InputBorder}"
                      BorderThickness="1"
                      Background="{DynamicResource Brush.InputBackground}"
                      Padding="9,0">
                <TextBlock Text="{Binding ProductSalePrice}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold" />
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Custo *"
                         FontSize="9"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <Grid>
                <TextBox Text="{Binding ProductPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PasswordChar="*"
                         IsVisible="{Binding IsProductEditCostHidden}"
                         PlaceholderText="********"
                         MinHeight="34"
                         Height="34"
                         Padding="25,4,38,4"
                         TextAlignment="Right" />
                <TextBox Text="{Binding ProductPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsVisible="{Binding IsProductEditCostVisible}"
                         MinHeight="34"
                         Height="34"
                         Padding="25,4,38,4"
                         TextAlignment="Right" />
                <TextBlock Text="R$"
                           Margin="8,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           FontSize="9"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <Button x:Name="productCostEyeButton"
                        Classes="list-header"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,3,0"
                        Width="28"
                        MinWidth="28"
                        Height="28"
                        MinHeight="28"
                        Padding="5"
                        ToolTip.Tip="Mantenha pressionado para revelar custo e lucro">
                  <PathIcon Data="{StaticResource Icon.Eye}"
                            Width="13"
                            Height="13"
                            Foreground="{DynamicResource Brush.AccentLight}" />
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="Lucro"
                         FontSize="9"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <Border Height="34"
                      CornerRadius="7"
                      BorderBrush="{DynamicResource Brush.InputBorder}"
                      BorderThickness="1"
                      Background="{DynamicResource Brush.InputBackground}"
                      Padding="8,0">
                <Grid>
                  <TextBlock Text="********"
                             IsVisible="{Binding IsProductEditCostHidden}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ProductProfit}"
                             IsVisible="{Binding IsProductEditCostVisible}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             FontSize="10"
                             FontWeight="SemiBold" />
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="3" Spacing="4">
              <TextBlock Text="% de lucro"
                         FontSize="9"
                         Foreground="{DynamicResource Brush.TextLabel}" />
              <Border Height="34"
                      CornerRadius="7"
                      BorderBrush="{DynamicResource Brush.InputBorder}"
                      BorderThickness="1"
                      Background="{DynamicResource Brush.InputBackground}"
                      Padding="8,0">
                <Grid>
                  <TextBlock Text="********"
                             IsVisible="{Binding IsProductEditCostHidden}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ProductProfitPercent}"
                             IsVisible="{Binding IsProductEditCostVisible}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             FontSize="10"
                             FontWeight="SemiBold" />
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Text="{Binding ProductFormMessage}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding IsProductFormError}"
                   Foreground="{DynamicResource Brush.Error}"
                   FontSize="10" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0"
            Padding="20,11">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="Os campos com * são obrigatórios."
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   FontSize="9" />
        <Button Grid.Column="1"
                Classes="secondary"
                Click="Cancel_Click"
                MinHeight="36"
                Padding="14,7">
          <TextBlock Text="Cancelar" />
        </Button>
        <Button Grid.Column="2"
                Classes="primary"
                Click="Save_Click"
                MinHeight="36"
                Padding="14,7">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource Icon.Save}"
                      Width="15"
                      Height="15"
                      Foreground="White" />
            <TextBlock Text="Salvar alterações" Foreground="White" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
