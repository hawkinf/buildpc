<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.AppBackground}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="40" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource Brush.SecondaryButton}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.ButtonText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextBody}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.HoverBackground}" />
  </Style>

  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.NavActiveText}" />
  </Style>

  <Style Selector="Button.nav.active PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentLight}" />
  </Style>

  <Style Selector="Button.nav.active TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.nav-active">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.NavActiveText}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="ComboBox, TextBox">
    <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.InputText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="44" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.component-selector">
    <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.InputText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!--
    A quantidade passou de ComboBox com cem entradas para NumericUpDown, que
    aceita qualquer valor digitado sem o limite artificial de 100.
  -->
  <Style Selector="NumericUpDown.quantity-selector">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>

  <Style Selector="Button.component-selector:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.HoverBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
  </Style>

  <Style Selector="Button.list-header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextLabel}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.list-header:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.HoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentLight}" />
  </Style>

  <Style Selector="Button.list-header.active">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentLight}" />
  </Style>

  <Style Selector="Button.price-mode">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="MinWidth" Value="56" />
  </Style>

  <Style Selector="Button.price-mode:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.HoverBackground}" />
  </Style>

  <Style Selector="Button.price-mode.active">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="ComboBox:focus, TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="18" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>

  <Style Selector="ScrollBar:vertical /template/ Thumb">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.input-group">
    <Setter Property="Background" Value="{DynamicResource Brush.InputGroupBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputGroupBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Border.component-row">
    <Setter Property="Background" Value="{DynamicResource Brush.RowPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Border.component-row.alternate">
    <Setter Property="Background" Value="{DynamicResource Brush.RowAlternate}" />
  </Style>

  <Style Selector="Border.product-image">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform"
                                       Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.product-image.has-image:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.9)" />
    <Setter Property="BoxShadow" Value="0 10 28 0 #B0000000" />
  </Style>

  <Style Selector="Border.edit-product-image">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Opacity" Value="0.96" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform"
                                       Duration="0:0:0.18" />
        <DoubleTransition Property="Opacity"
                          Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.edit-product-image.has-image:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.16)" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #78000000" />
  </Style>

  <Style Selector="Border.price-preview">
    <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="0 12 34 0 #88000000" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(0.96)" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform"
                                       Duration="0:0:0.16" />
        <DoubleTransition Property="Opacity"
                          Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.price-preview.visible">
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Border.catalog-row">
    <Setter Property="Background" Value="{DynamicResource Brush.RowPrimary}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Border.catalog-row.alternate">
    <Setter Property="Background" Value="{DynamicResource Brush.RowAlternate}" />
  </Style>

  <Style Selector="Border.catalog-row.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
  </Style>

  <Style Selector="Button.catalog-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.catalog-item:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.catalog-item:pointerover Border.catalog-row">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
  </Style>

  <Style Selector="Border.option-row">
    <Setter Property="Background" Value="{DynamicResource Brush.RowPrimary}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <Style Selector="Border.option-row.alternate">
    <Setter Property="Background" Value="{DynamicResource Brush.RowAlternate}" />
  </Style>

  <Style Selector="Border.option-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.HoverBackground}" />
  </Style>

  <Style Selector="Border.component-picker">
    <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #80000000" />
  </Style>

  <Style Selector="ListBox.component-options">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.component-options ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="PathIcon.issue-icon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <Style Selector="PathIcon.issue-icon.error">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
  </Style>

  <Style Selector="PathIcon.issue-icon.warning">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
  </Style>

  <Style Selector="PathIcon.issue-icon.success">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
  </Style>

  <!--
    Folga no fim de toda tela rolável, para o último controle poder subir
    inteiramente acima do rodapé fixo. Antes o valor estava repetido em cinco
    views e podia divergir entre elas.
  -->
  <Style Selector="Border.scroll-safe-area">
    <Setter Property="Height" Value="180" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
</Styles>
