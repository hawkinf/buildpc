@using BuildPc.Core.Models
@inject IComponentCatalogRepository CatalogRepository
@inject IQuoteRepository QuoteRepository
@implements IDisposable

@if (_loadError is not null)
{
    <p class="price-error">Falha ao carregar o catálogo: @_loadError</p>
}
else if (_isLoading)
{
    <p>Carregando catálogo...</p>
}
else
{
    <div class="price-categories">
        <div class="price-categories-header">
            <span class="price-categories-label">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13" /><path d="M3 6h.01M3 12h.01M3 18h.01" /></svg>
                Categorias
            </span>
            <div class="price-view-toggle">
                <button
                    type="button"
                    class="@(!_useCategoryDropdown ? "active" : null)"
                    title="Ver como botões"
                    @onclick="() => SetCategoryDropdown(false)">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="9" width="8" height="6" rx="3" /><rect x="12" y="9" width="10" height="6" rx="3" /></svg>
                </button>
                <button
                    type="button"
                    class="@(_useCategoryDropdown ? "active" : null)"
                    title="Ver como menu"
                    @onclick="() => SetCategoryDropdown(true)">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
            </div>
        </div>

        @if (_useCategoryDropdown)
        {
            <select value="@SelectedCategoryValue" @onchange="OnCategoryDropdownChanged">
                <option value="">Todos (@TotalCount())</option>
                @foreach (var category in _categories)
                {
                    <option value="@category.Value">
                        @category.Name (@CountFor(category.Value))
                    </option>
                }
            </select>
        }
        else
        {
            <div class="price-categories-row">
                <button
                    type="button"
                    class="@(_selectedCategory is null ? "active" : null)"
                    @onclick="() => SelectCategory(null)">
                    Todos (@TotalCount())
                </button>
                @foreach (var category in _categories)
                {
                    <button
                        type="button"
                        class="@(_selectedCategory == category.Value ? "active" : null)"
                        @onclick="() => SelectCategory(category.Value)">
                        @category.Name (@CountFor(category.Value))
                    </button>
                }
            </div>
        }
    </div>

    <div class="price-toolbar">
        <input
            type="search"
            placeholder="Buscar por nome, marca, descrição..."
            value="@_searchText"
            @oninput="OnSearchInput" />

        @if (AllowCostToggle)
        {
            <label class="price-cost-check">
                <input type="checkbox" checked="@_showCost" @onchange="OnShowCostChanged" />
                Custo
            </label>
        }

        <div class="price-view-toggle">
            <button
                type="button"
                class="@(!_isGridView ? "active" : null)"
                title="Ver em lista"
                @onclick="() => SetGridView(false)">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13" /><path d="M3 6h.01M3 12h.01M3 18h.01" /></svg>
            </button>
            <button
                type="button"
                class="@(_isGridView ? "active" : null)"
                title="Ver em quadros"
                @onclick="() => SetGridView(true)">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1.5" /><rect x="13" y="3" width="8" height="8" rx="1.5" /><rect x="3" y="13" width="8" height="8" rx="1.5" /><rect x="13" y="13" width="8" height="8" rx="1.5" /></svg>
            </button>
        </div>

        <a class="price-pdf-link" href="@PdfDownloadUrl" target="_blank">
            Exportar PDF
        </a>
    </div>

    <p class="price-count">@CountText</p>

    @if (_isGridView)
    {
        <div class="price-grid-sort">
            <button type="button" class="price-sort-button" @onclick="() => ToggleSort(byPrice: false)">
                Nome @(SortIcon(byPrice: false))
            </button>
            <button type="button" class="price-sort-button" @onclick="() => ToggleSort(byPrice: true)">
                Preço @(SortIcon(byPrice: true))
            </button>
        </div>

        <div class="price-grid">
            @foreach (var row in _rows)
            {
                <div class="price-card">
                    <div class="price-card-thumb">
                        @if (!string.IsNullOrWhiteSpace(row.ImageUrl))
                        {
                            <img src="@row.ImageUrl" alt="" loading="lazy" />
                        }
                    </div>
                    <ProductHoverPreview
                        Title="@row.Title"
                        Description="@row.Description"
                        ImageUrl="@row.ImageUrl"
                        Price="@row.Price.ToString("C", CultureHelpers.BrazilianCulture)">
                        <span class="price-card-name">@row.Title</span>
                    </ProductHoverPreview>
                    <div class="price-card-prices">
                        @if (ShowCost)
                        {
                            <span class="price-cost">@row.CostPrice.ToString("C", CultureHelpers.BrazilianCulture)</span>
                        }
                        <span class="price-sale">@row.Price.ToString("C", CultureHelpers.BrazilianCulture)</span>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="price-table-wrap">
        <table class="price-table">
            <thead>
                <tr>
                    <th class="price-thumb-cell"></th>
                    <th class="price-name-cell">
                        <button type="button" class="price-sort-button" @onclick="() => ToggleSort(byPrice: false)">
                            Produto @(SortIcon(byPrice: false))
                        </button>
                    </th>
                    <th class="price-price-cell">
                        <button type="button" class="price-sort-button" @onclick="() => ToggleSort(byPrice: true)">
                            Preço de venda @(SortIcon(byPrice: true))
                        </button>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td class="price-thumb-cell">
                            @if (!string.IsNullOrWhiteSpace(row.ImageUrl))
                            {
                                <img class="price-thumb" src="@row.ImageUrl" alt="" loading="lazy" />
                            }
                        </td>
                        <td class="price-name-cell">
                            <ProductHoverPreview
                                Title="@row.Title"
                                Description="@row.Description"
                                ImageUrl="@row.ImageUrl"
                                Price="@row.Price.ToString("C", CultureHelpers.BrazilianCulture)">
                                @row.Title
                            </ProductHoverPreview>
                        </td>
                        <td class="price-price-cell">
                            <span class="price-pair">
                                @if (ShowCost)
                                {
                                    <span class="price-cost">@row.CostPrice.ToString("C", CultureHelpers.BrazilianCulture)</span>
                                    <span class="price-dash">-</span>
                                }
                                <span class="price-sale">@row.Price.ToString("C", CultureHelpers.BrazilianCulture)</span>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
}

@code {
    // Trava definitiva: sem isto, a tela pública nunca revela custo, nem
    // por engano futuro em outro trecho do código -- toda leitura de custo
    // na marcação usa ShowCost (nunca _showCost puro), então mesmo que
    // _showCost virasse true por algum bug, ShowCost continua false aqui.
    [Parameter]
    public bool AllowCostToggle { get; set; }

    private IReadOnlyList<PcComponent> _catalog = [];
    private BusinessSettings _settings = new();
    private IReadOnlyList<ProductCategoryDefinition> _categories = [];
    private IReadOnlyList<ProductPriceTableRow> _rows = [];
    private ComponentCategory? _selectedCategory;
    private string _searchText = string.Empty;
    private PriceTableSortMode _sortMode = PriceTableSortMode.NameAscending;
    private bool _showCost;
    private bool _isGridView;
    private bool _useCategoryDropdown;
    private bool _isLoading = true;
    private string? _loadError;
    private CancellationTokenSource? _searchDebounce;

    private bool ShowCost => AllowCostToggle && _showCost;

    private string SelectedCategoryValue => _selectedCategory?.ToString() ?? string.Empty;

    private string CountText => _rows.Count switch
    {
        0 => "Nenhum produto encontrado.",
        1 => "1 produto",
        _ => $"{_rows.Count} produtos"
    };

    private string PdfDownloadUrl
    {
        get
        {
            var query = new List<string>
            {
                $"sort={Uri.EscapeDataString(_sortMode.ToString())}",
                $"priceMode={(ShowCost ? "custo" : "venda")}"
            };
            if (_selectedCategory is not null)
            {
                query.Add($"category={Uri.EscapeDataString(_selectedCategory.Value.ToString())}");
            }
            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                query.Add($"search={Uri.EscapeDataString(_searchText)}");
            }
            return $"pdf/tabela-precos?{string.Join('&', query)}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _catalog = await CatalogRepository.GetAllAsync();
            _settings = await QuoteRepository.GetSettingsAsync();
            _categories = _settings.EffectiveProductCategories();
            RefreshRows();
        }
        catch (InvalidOperationException exception)
        {
            _loadError = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Contagem sempre pelo total da categoria, sem levar a busca em conta --
    // filtrar por texto não pode "zerar" as pills de categorias que não
    // batem com a busca, o número tem que ficar estável.
    private int CountFor(ComponentCategory category) =>
        _catalog.Count(component => component.Category == category);

    private int TotalCount() => _catalog.Count;

    private void SelectCategory(ComponentCategory? category)
    {
        _selectedCategory = category;
        // Trocar de categoria começa uma busca nova -- um filtro de texto
        // antigo escondendo produtos da categoria recém-selecionada confunde.
        _searchText = string.Empty;
        RefreshRows();
    }

    private void OnCategoryDropdownChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        SelectCategory(string.IsNullOrEmpty(value) ? null : Enum.Parse<ComponentCategory>(value));
    }

    private void SetCategoryDropdown(bool useDropdown) => _useCategoryDropdown = useDropdown;

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;

        _searchDebounce?.Cancel();
        _searchDebounce = new CancellationTokenSource();
        _ = DebounceRefreshAsync(_searchDebounce.Token);
    }

    private async Task DebounceRefreshAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(300), token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        RefreshRows();
        await InvokeAsync(StateHasChanged);
    }

    private void OnShowCostChanged(ChangeEventArgs e)
    {
        if (!AllowCostToggle)
        {
            return;
        }

        _showCost = (bool)(e.Value ?? false);
        RefreshRows();
    }

    private void SetGridView(bool isGridView) => _isGridView = isGridView;

    private void ToggleSort(bool byPrice)
    {
        _sortMode = (byPrice, _sortMode) switch
        {
            (false, PriceTableSortMode.NameAscending) => PriceTableSortMode.NameDescending,
            (false, _) => PriceTableSortMode.NameAscending,
            (true, PriceTableSortMode.PriceAscending) => PriceTableSortMode.PriceDescending,
            (true, _) => PriceTableSortMode.PriceAscending
        };
        RefreshRows();
    }

    private string SortIcon(bool byPrice)
    {
        var ascending = byPrice
            ? _sortMode == PriceTableSortMode.PriceAscending
            : _sortMode == PriceTableSortMode.NameAscending;
        var isActive = byPrice
            ? _sortMode is PriceTableSortMode.PriceAscending or PriceTableSortMode.PriceDescending
            : _sortMode is PriceTableSortMode.NameAscending or PriceTableSortMode.NameDescending;
        if (!isActive)
        {
            return string.Empty;
        }
        return ascending ? "▲" : "▼";
    }

    // O preço de venda é sempre a base de ordenação/exibição; o checkbox só
    // acrescenta o custo ao lado, não troca de modo — por isso showSalePrice
    // vai sempre true aqui (CostPrice já vem preenchido independente disso).
    private void RefreshRows() =>
        _rows = PriceTableRowBuilder.Build(
            _catalog,
            _settings,
            _selectedCategory,
            _searchText,
            _sortMode,
            showSalePrice: true);

    public void Dispose() => _searchDebounce?.Cancel();
}
