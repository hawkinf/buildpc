@page "/login"
@attribute [AllowAnonymous]
@layout PublicLayout

<PageTitle>Entrar - Hawk Informática</PageTitle>

<div class="login-hero">
    <form method="post" action="/account/login" class="login-card">
        <span class="login-eyebrow">Hawk Informática</span>
        <h1>Área da equipe</h1>
        <p class="login-tagline">Digite a senha da equipe para acessar custos, orçamentos e configurações.</p>
        <label for="password">Senha</label>
        <input type="password" id="password" name="password" autofocus required />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <button type="submit" class="login-submit">Entrar</button>
        <a href="/consulta" class="login-skip">Ver tabela de preços sem senha</a>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
}
