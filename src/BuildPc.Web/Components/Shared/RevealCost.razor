@implements IDisposable
@inject RevealAccessState AccessState

@if (_showPasswordPrompt)
{
    <span class="reveal-cost-unlock">
        <input
            type="password"
            class="reveal-cost-unlock-input"
            placeholder="Senha"
            value="@_passwordAttempt"
            autofocus
            @oninput="e => _passwordAttempt = e.Value?.ToString() ?? string.Empty"
            @onkeydown="OnPasswordKeyDown" />
        <button type="button" class="reveal-cost-unlock-submit" @onclick="SubmitPassword" title="Confirmar">✓</button>
        <button type="button" class="reveal-cost-unlock-cancel" @onclick="CancelPasswordPrompt" title="Cancelar">✕</button>
        @if (_showError)
        {
            <span class="reveal-cost-error">Senha incorreta</span>
        }
    </span>
}
else
{
    <button type="button" class="reveal-cost" title="Toque para ver" @onclick="Reveal">
        @if (_revealed)
        {
            <span>@FormattedValue</span>
        }
        else
        {
            <span class="reveal-cost-masked" aria-hidden="true">•••••</span>
        }
    </button>
}

@code {
    [Parameter, EditorRequired]
    public decimal Value { get; set; }

    // Revelado junto com o valor, nunca separado: um percentual de lucro
    // sozinho já permitiria calcular o custo de volta a partir do total de
    // venda (sempre visível), então não pode ficar visível antes do toque.
    [Parameter]
    public string? Suffix { get; set; }

    // Toque revela por alguns segundos em vez de "segurar" (padrão do
    // Desktop): mais confiável em touch, onde toque longo costuma abrir o
    // menu de contexto do navegador/SO.
    [Parameter]
    public int RevealSeconds { get; set; } = 5;

    private bool _revealed;
    private bool _showPasswordPrompt;
    private bool _showError;
    private string _passwordAttempt = string.Empty;
    private CancellationTokenSource? _cts;

    private string FormattedValue => string.IsNullOrEmpty(Suffix)
        ? Value.ToString("C", CultureHelpers.BrazilianCulture)
        : $"{Value.ToString("C", CultureHelpers.BrazilianCulture)} {Suffix}";

    private void Reveal()
    {
        if (_revealed)
        {
            // Tocar de novo enquanto está revelado esconde na hora, em vez
            // de esperar o tempo normal esgotar.
            _cts?.Cancel();
            _revealed = false;
            return;
        }

        if (!AccessState.IsUnlocked)
        {
            _showPasswordPrompt = true;
            _showError = false;
            _passwordAttempt = string.Empty;
            return;
        }

        _revealed = true;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _ = HideAfterDelayAsync(_cts.Token);
    }

    private void SubmitPassword()
    {
        if (AccessState.TryUnlock(_passwordAttempt))
        {
            _showPasswordPrompt = false;
            _passwordAttempt = string.Empty;
            Reveal();
        }
        else
        {
            _showError = true;
            _passwordAttempt = string.Empty;
        }
    }

    private void CancelPasswordPrompt()
    {
        _showPasswordPrompt = false;
        _showError = false;
        _passwordAttempt = string.Empty;
    }

    private void OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SubmitPassword();
        }
        else if (e.Key == "Escape")
        {
            CancelPasswordPrompt();
        }
    }

    private async Task HideAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(RevealSeconds), token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _revealed = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
