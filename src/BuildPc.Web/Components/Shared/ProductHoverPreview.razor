<span class="product-hover-wrap">
    @ChildContent
    <span class="product-hover-popup">
        <span class="product-hover-image">
            @if (!string.IsNullOrWhiteSpace(ImageUrl))
            {
                <img src="@ImageUrl" alt="" loading="lazy" />
            }
        </span>
        <span class="product-hover-info">
            <span class="product-hover-title">@Title</span>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <span class="product-hover-description">@Description</span>
            }
            @if (!string.IsNullOrWhiteSpace(Price))
            {
                <span class="product-hover-price">@Price</span>
            }
        </span>
    </span>
</span>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? ImageUrl { get; set; }

    // String já formatada (ex.: "R$ 1.234,56") — mesma convenção do
    // ProductHoverPreview do Desktop, que também recebe o preço pronto em
    // vez de reformatar um decimal.
    [Parameter]
    public string? Price { get; set; }
}
