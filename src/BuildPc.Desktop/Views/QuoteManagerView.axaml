<UserControl
    x:Class="BuildPc.Desktop.Views.QuoteManagerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BuildPc.Desktop.Controls"
    xmlns:vm="clr-namespace:BuildPc.Desktop.ViewModels"
    x:CompileBindings="True"
    x:DataType="vm:QuoteManagerViewModel">

  <Grid RowDefinitions="Auto,*">
    <Border BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="30,14,46,14">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="Gerenciador de orçamentos" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Consulte os orçamentos gravados e gere novamente seus PDFs."
                       Foreground="{DynamicResource Brush.TextBodyMuted}" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">
            <!-- A lista só crescia e não tinha filtro nenhum. -->
            <Grid Width="260">
              <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Buscar orçamento por número, cliente, telefone ou produto"
                       PlaceholderText="Número, cliente, telefone ou produto"
                       Padding="12,8,34,8" />
              <Button Classes="list-header"
                      Command="{Binding ClearSearchCommand}"
                      IsVisible="{Binding HasSearch}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,6,0"
                      MinWidth="24"
                      Padding="4"
                      AutomationProperties.Name="Limpar a busca"
                      ToolTip.Tip="Limpar a busca">
                <PathIcon Data="{StaticResource Icon.Clear}" Width="11" Height="11"
                          Foreground="{DynamicResource Brush.TextSecondary}" />
              </Button>
            </Grid>
            <ComboBox ItemsSource="{Binding Periods}"
                      SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"
                      AutomationProperties.Name="Período dos orçamentos exibidos"
                      MinWidth="160">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:QuotePeriodOptionViewModel">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="secondary" Click="Refresh_Click">
              <TextBlock Text="Atualizar lista" />
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              DataContext="{Binding SelectedQuote}"
              ColumnDefinitions="*,*,*,*,Auto,Auto,Auto,Auto"
              ColumnSpacing="18">
          <StackPanel>
            <TextBlock Text="TOTAL"
                       FontSize="11.25"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="{Binding TotalText}"
                       FontSize="16.25"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.AccentLight}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="CUSTO"
                       FontSize="11.25"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="{Binding CostText}"
                       FontSize="16.25"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Error}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="LUCRO"
                       FontSize="11.25"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="{Binding ProfitText}"
                       FontSize="16.25"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Success}" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Text="% LUCRO"
                       FontSize="11.25"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="{Binding ProfitPercentText}"
                       FontSize="16.25"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Success}" />
          </StackPanel>
          <Button Grid.Column="4"
                  Classes="secondary"
                  Command="{Binding $parent[UserControl].DataContext.OpenInAssemblyCommand}"
                  IsEnabled="{Binding $parent[UserControl].DataContext.HasSelection}"
                  MinHeight="36"
                  Padding="12,8"
                  AutomationProperties.Name="Abrir este orçamento na Montagem para consultar ou ajustar"
                  ToolTip.Tip="Abrir este orçamento na Montagem para consultar ou ajustar">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Assembly}" Width="16" Height="16"
                        Foreground="{DynamicResource Brush.AccentLight}" />
              <TextBlock Text="Abrir na Montagem" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <CheckBox Content="Descrição"
                      IsChecked="{Binding $parent[UserControl].DataContext.IncludeDescriptionsInPdf, Mode=TwoWay}"
                      AutomationProperties.Name="Incluir descrição no PDF exportado" />
            <Button Classes="primary"
                    Click="ExportPdf_Click"
                    MinHeight="36"
                    Padding="12,8"
                    IsEnabled="{Binding $parent[UserControl].DataContext.HasSelection}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Pdf}" Width="16" Height="16"
                          Foreground="White" />
                <TextBlock Text="Exportar PDF" Foreground="White" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Button Grid.Column="6"
                  Classes="secondary"
                  Command="{Binding $parent[UserControl].DataContext.DuplicateCommand}"
                  IsEnabled="{Binding $parent[UserControl].DataContext.HasSelection}"
                  MinHeight="36"
                  MinWidth="36"
                  Padding="9,8"
                  AutomationProperties.Name="Duplicar: abre uma cópia na Montagem para gravar como novo"
                  ToolTip.Tip="Duplicar: abre uma cópia na Montagem para gravar como novo">
            <PathIcon Data="{StaticResource Icon.Copy}" Width="15" Height="15"
                      Foreground="{DynamicResource Brush.AccentLight}" />
          </Button>
          <Button Grid.Column="7"
                  Classes="secondary"
                  Command="{Binding $parent[UserControl].DataContext.RequestDeleteCommand}"
                  IsEnabled="{Binding $parent[UserControl].DataContext.HasSelection}"
                  MinHeight="36"
                  MinWidth="36"
                  Padding="9,8"
                  AutomationProperties.Name="Excluir o orçamento selecionado"
                  ToolTip.Tip="Excluir o orçamento selecionado">
            <PathIcon Data="{StaticResource Icon.Clear}" Width="15" Height="15"
                      Foreground="{DynamicResource Brush.Error}" />
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            IsVisible="{Binding IsDeleteConfirmationVisible}"
            ZIndex="900"
            VerticalAlignment="Top"
            Margin="30,10,46,0"
            Background="{DynamicResource Brush.WarningBackground}"
            BorderBrush="{DynamicResource Brush.Warning}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,13">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBlock Text="{Binding DeleteConfirmationMessage}"
                   TextWrapping="Wrap"
                   FontSize="11"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Warning}" />
        <Button Grid.Column="1"
                Classes="secondary"
                Command="{Binding CancelDeleteCommand}">
          <TextBlock Text="Cancelar" />
        </Button>
        <Button Grid.Column="2"
                Classes="secondary"
                Command="{Binding ConfirmDeleteCommand}">
          <TextBlock Text="Sim, excluir"
                     Foreground="{DynamicResource Brush.Error}" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="390,*" ColumnSpacing="18" Margin="30,22,46,28">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="ORÇAMENTOS GRAVADOS" FontSize="10" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="1">
              <TextBlock Text="{Binding CountText}" FontSize="9"
                         TextAlignment="Right"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
              <!-- Total do recorte visível: fechamento rápido por período. -->
              <TextBlock Text="{Binding FilteredTotalText}" FontSize="10"
                         FontWeight="SemiBold"
                         TextAlignment="Right"
                         IsVisible="{Binding HasQuotes}"
                         Foreground="{DynamicResource Brush.AccentLight}" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1"
                      IsVisible="{Binding IsEmpty}"
                      Spacing="6"
                      Margin="0,40,0,0"
                      HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Assembly}"
                      Width="28" Height="28"
                      HorizontalAlignment="Center"
                      Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="Nenhum orçamento gravado ainda"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock Text="Monte um orçamento na Montagem e grave para vê-lo aqui."
                       FontSize="10"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="220"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Quotes}"
                   IsVisible="{Binding !IsEmpty}"
                   AutomationProperties.Name="Orçamentos gravados"
                   SelectedItem="{Binding SelectedQuote, Mode=TwoWay}"
                   Padding="0,0,22,180">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SavedQuoteListItemViewModel">
                <Border Classes="catalog-row" Margin="0,0,0,6" Padding="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding NumberText}" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.AccentPale}" />
                      <TextBlock Text="{Binding ClientText}" FontSize="11" />
                      <TextBlock Text="{Binding DateText}" FontSize="9"
                                 Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="{Binding TotalText}" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.Warning}"
                                 TextAlignment="Right" />
                      <TextBlock Text="{Binding ItemsText}" FontSize="9"
                                 Foreground="{DynamicResource Brush.TextSecondary}"
                                 TextAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <Grid>
        <StackPanel IsVisible="{Binding !HasSelection}"
                    Spacing="6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource Icon.Assembly}"
                    Width="28" Height="28"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextMuted}" />
          <TextBlock Text="Selecione um orçamento à esquerda"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     Foreground="{DynamicResource Brush.TextSecondary}" />
        </StackPanel>
        <Grid IsVisible="{Binding HasSelection}">
        <Grid DataContext="{Binding SelectedQuote}" RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel>
            <TextBlock Text="{Binding NumberText}" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource Brush.TextSecondary}" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,18,0,14">
            <StackPanel>
              <TextBlock Text="CLIENTE" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock Text="{Binding ClientText}" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="TELEFONE" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock Text="{Binding PhoneText}" FontSize="14" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}"
                          Margin="0,0,36,180">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SavedQuoteItemListItemViewModel">
                  <Border x:Name="savedQuoteProductRow"
                          Classes="component-row"
                          Classes.alternate="{Binding IsAlternate}"
                          Margin="0,0,0,7" Padding="10">
                    <Grid ColumnDefinitions="54,*,170">
                      <TextBlock Text="{Binding Quantity, StringFormat='{}{0}x'}"
                                 VerticalAlignment="Center" FontWeight="Bold" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CategoryName}" FontSize="9"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2"
                                  Spacing="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalPriceText}"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalCostText, StringFormat='Custo: {0}'}"
                                   TextAlignment="Right"
                                   FontSize="9"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                      </StackPanel>
                      <controls:ProductHoverPreview
                          Grid.ColumnSpan="3"
                          PlacementTarget="{Binding #savedQuoteProductRow}"
                          Title="{Binding Name}"
                          Description="{Binding Description}"
                          ImageUrl="{Binding ImageUrl}"
                          Price="{Binding TotalPriceText}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="3"
                     Text="{Binding $parent[UserControl].DataContext.StatusMessage}"
                     Margin="0,8,0,0"
                     FontSize="9"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.TextSecondary}" />
        </Grid>
        </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
