[Unit]
Description=Backup do PostgreSQL do BuildPC
After=postgresql.service
Requires=postgresql.service
OnFailure=buildpc-backup-alert.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/sbin/backup-buildpc
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/buildpc
