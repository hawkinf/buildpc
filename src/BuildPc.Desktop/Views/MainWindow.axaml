<Window
    x:Class="BuildPc.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BuildPc.Desktop.Controls"
    xmlns:views="clr-namespace:BuildPc.Desktop.Views"
    Title="BuildPC — Monte seu computador"
    Icon="/Assets/Brand/buildpc.ico"
    Width="1440"
    Height="900"
    MinWidth="1280"
    MinHeight="640"
    WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="230,*" RowDefinitions="*,38">
    <!-- Navegação -->
    <Border Grid.Column="0" Background="{DynamicResource Brush.SidebarBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="22,26">
        <StackPanel Orientation="Horizontal" Spacing="11">
          <Image Source="/Assets/Brand/buildpc.png"
                 Width="38" Height="38"
                 Stretch="Uniform" />
          <StackPanel VerticalAlignment="Center" Spacing="-3">
            <TextBlock Text="BUILDPC" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="PC configurator" FontSize="11" Foreground="{DynamicResource Brush.TextSubtle}" />
          </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,42,0,10"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8">
            <Button Classes="nav" Classes.active="{Binding IsFlexibleListView}"
                    Command="{Binding ShowFlexibleListCommand}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource Icon.Assembly}" Width="18" Height="18" />
                <TextBlock Text="Montagem" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="nav" Classes.active="{Binding IsPriceLookupView}"
                    Command="{Binding ShowPriceLookupCommand}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource Icon.Currency}" Width="18" Height="18" />
                <TextBlock Text="Consultar preço" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="nav" Classes.active="{Binding IsQuotesView}"
                    Command="{Binding ShowQuotesCommand}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource Icon.Quotes}" Width="18" Height="18" />
                <TextBlock Text="Orçamentos" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="nav" Classes.active="{Binding IsToolsView}"
                    Command="{Binding ToggleToolsMenuCommand}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <PathIcon Data="{StaticResource Icon.Settings}" Width="18" Height="18" />
                <TextBlock Grid.Column="1"
                           Text="Ferramentas"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ToolsMenuIndicator}"
                           FontSize="16"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <StackPanel IsVisible="{Binding IsToolsMenuExpanded}"
                        Spacing="4"
                        Margin="18,0,0,0">
              <Button Classes="nav"
                      Classes.active="{Binding IsImportsView}"
                      Command="{Binding ShowImportsCommand}"
                      MinHeight="34"
                      Padding="10,7">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{StaticResource Icon.Imports}" Width="15" Height="15" />
                  <TextBlock Text="Importações"
                             FontSize="12"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="nav"
                      Classes.active="{Binding IsProductCatalogManagementActive}"
                      Command="{Binding ShowProductsCommand}"
                      MinHeight="34"
                      Padding="10,7">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{StaticResource Icon.Products}" Width="15" Height="15" />
                  <TextBlock Text="Gerenciar Produtos"
                             FontSize="12"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="nav"
                      Classes.active="{Binding IsCategoryManagementView}"
                      Command="{Binding ShowCategoryManagementCommand}"
                      MinHeight="34"
                      Padding="10,7">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{StaticResource Icon.Components}" Width="15" Height="15" />
                  <TextBlock Text="Gerenciar Categorias"
                             FontSize="12"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="nav"
                      Classes.active="{Binding IsSettingsView}"
                      Command="{Binding ShowSettingsCommand}"
                      MinHeight="34"
                      Padding="10,7">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{StaticResource Icon.Settings}" Width="15" Height="15" />
                  <TextBlock Text="Configurações"
                             FontSize="12"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource Brush.PanelBackground}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="9" Padding="10">
          <StackPanel Spacing="3">
            <TextBlock Text="CATÁLOGO LOCAL" Foreground="{DynamicResource Brush.TextMuted}" FontSize="9" FontWeight="Bold" />
            <TextBlock Text="{Binding CatalogCountText}" FontSize="11" Foreground="{DynamicResource Brush.TextStrong}" />
            <Border Height="1"
                    Margin="0,4,0,3"
                    Background="{DynamicResource Brush.Border}" />
            <ItemsControl ItemsSource="{Binding CatalogCategorySummaries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding TotalDisplayName}"
                             FontSize="9"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource Brush.TextSecondary}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Montagem -->
    <Grid Grid.Column="1"
          IsVisible="{Binding IsFlexibleListView}">
      <views:FlexibleListView DataContext="{Binding FlexibleList}" />
    </Grid>

    <!-- Orçamentos -->
    <Grid Grid.Column="1"
          IsVisible="{Binding IsQuotesView}">
      <views:QuoteManagerView DataContext="{Binding QuoteManager}" />
    </Grid>

    <!-- Configurações -->
    <Grid Grid.Column="1"
          IsVisible="{Binding IsSettingsView}">
      <views:PricingSettingsView DataContext="{Binding PricingSettings}" />
    </Grid>

    <!-- Gerenciamento de categorias -->
    <Grid Grid.Column="1"
          IsVisible="{Binding IsCategoryManagementView}">
      <views:CategoryManagementView DataContext="{Binding CategoryManagement}" />
    </Grid>

    <!-- Cadastro manual de produtos -->
    <Grid Grid.Column="1"
          IsVisible="{Binding IsProductManagementView}">
      <views:ProductManagementView DataContext="{Binding}" />
    </Grid>

    <!-- Gerenciamento de produtos e catálogo local -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*"
          IsVisible="{Binding IsProductsView}">
      <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="30,20">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="Gerenciar Produtos" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Consulte, edite, exclua e exporte os produtos do Catálogo Local."
                       Foreground="{DynamicResource Brush.TextBodyMuted}" FontSize="12" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="primary"
                  Command="{Binding ShowProductManagementCommand}"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource Icon.Add}"
                        Width="15"
                        Height="15"
                        Foreground="White" />
              <TextBlock Text="Novo produto" Foreground="White" />
            </StackPanel>
          </Button>
          <Border Grid.Column="2" Background="{DynamicResource Brush.AccentSurface}" CornerRadius="8" Padding="12,7"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding CatalogCountText}" Foreground="{DynamicResource Brush.AccentBadge}"
                       FontSize="11" FontWeight="SemiBold" />
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="*" Margin="30,22">
        <Border Grid.Column="0" Classes="card" Padding="0">
          <Grid RowDefinitions="Auto,Auto,*">
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="18,16">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Text="Catálogo local" FontSize="15" FontWeight="Bold" />
                  <TextBlock Text="Produtos disponíveis para suas configurações"
                             Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding FilteredCatalogCountText}"
                           Foreground="{DynamicResource Brush.AccentLight}"
                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1" Padding="18,12">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="240,*,Auto,Auto,Auto" ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding ProductCategoryFilters}"
                            SelectedItem="{Binding SelectedCatalogCategoryFilter, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Grid.Column="1"
                           Text="{Binding CatalogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="Palavras-chave: nvme 256 adata" />
                  <Border Grid.Column="2"
                          Background="{DynamicResource Brush.PanelBackground}"
                          CornerRadius="7"
                          Padding="3">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <Button Classes="price-mode"
                              Classes.active="{Binding IsCatalogCostDisplayActive}"
                              Command="{Binding ShowCatalogCostCommand}"
                              ToolTip.Tip="Mostrar valores de custo">
                        <TextBlock Text="Custo" />
                      </Button>
                      <Button Classes="price-mode"
                              Classes.active="{Binding IsCatalogSaleDisplayActive}"
                              Command="{Binding ShowCatalogSaleCommand}"
                              ToolTip.Tip="Mostrar valores de venda">
                        <TextBlock Text="Venda" />
                      </Button>
                    </StackPanel>
                  </Border>
                  <Button Grid.Column="3"
                          Classes="secondary"
                          Click="ExportProductPriceTablePdf_Click"
                          IsEnabled="{Binding CanExportProductPriceTable}"
                          Width="44"
                          MinWidth="44"
                          Height="44"
                          MinHeight="44"
                          Padding="10"
                          ToolTip.Tip="Exportar o preço selecionado para PDF">
                    <PathIcon Data="{StaticResource Icon.Pdf}"
                              Width="17"
                              Height="17"
                              Foreground="{DynamicResource Brush.AccentLight}" />
                  </Button>
                  <TextBlock Grid.Column="4" Text="{Binding BulkSelectedText}"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}" />
                </Grid>

                <Border Classes="input-group" Padding="10"
                        IsVisible="{Binding IsBulkDeleteConfirmationVisible}">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding BulkSelectedText, StringFormat='Apagar {0}?'}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Error}" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Classes="secondary"
                            Command="{Binding ConfirmBulkDeleteCommand}">
                      <TextBlock Text="Confirmar" Foreground="{DynamicResource Brush.Error}" />
                    </Button>
                    <Button Grid.Column="2" Classes="secondary"
                            Command="{Binding CancelBulkDeleteCommand}">
                      <TextBlock Text="Cancelar" />
                    </Button>
                  </Grid>
                </Border>

                <Grid ColumnDefinitions="24,Auto,*,115" ColumnSpacing="8">
                  <CheckBox IsChecked="{Binding AreAllFilteredProductsSelected, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Marcar ou desmarcar todos os produtos visíveis" />
                  <Button Grid.Column="1" Classes="secondary"
                          Command="{Binding RequestBulkDeleteCommand}"
                          IsEnabled="{Binding HasBulkSelection}"
                          Padding="7" MinWidth="32"
                          ToolTip.Tip="Apagar produtos marcados">
                    <PathIcon Data="{StaticResource Icon.Clear}" Width="14" Height="14"
                              Foreground="{DynamicResource Brush.Error}" />
                  </Button>
                  <Button Grid.Column="2" Classes="list-header"
                          Classes.active="{Binding IsCatalogDescriptionSortActive}"
                          Command="{Binding SortCatalogByDescriptionCommand}"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Bottom"
                          Padding="6,4,6,2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="DESCRIÇÃO" FontSize="9" FontWeight="Bold" />
                      <PathIcon Data="{Binding CatalogDescriptionSortIcon,
                                              Converter={StaticResource IconResourceConverter}}"
                                IsVisible="{Binding IsCatalogDescriptionSortActive}"
                                Width="12" Height="12" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="3" Classes="list-header"
                          Classes.active="{Binding IsCatalogCostSortActive}"
                          Command="{Binding SortCatalogByCostCommand}"
                          HorizontalContentAlignment="Right"
                          VerticalContentAlignment="Bottom"
                          Padding="6,4,6,2">
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Right">
                      <TextBlock Text="{Binding CatalogPriceColumnTitle}"
                                 FontSize="9" FontWeight="Bold" />
                      <PathIcon Data="{Binding CatalogCostSortIcon,
                                              Converter={StaticResource IconResourceConverter}}"
                                IsVisible="{Binding IsCatalogCostSortActive}"
                                Width="12" Height="12" />
                    </StackPanel>
                  </Button>
                </Grid>

              </StackPanel>
            </Border>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding FilteredProducts}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="18,12,18,180"
                     SelectionMode="Single">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,0,0,4" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <CheckBox IsChecked="{Binding IsBulkSelected, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Marcar para alteração em massa" />
                    <Button Grid.Column="1" Classes="catalog-item"
                            Click="CatalogProduct_Click"
                            ToolTip.Tip="Clique para editar o produto">
                      <Border x:Name="catalogProductRow"
                              Classes="catalog-row"
                              Classes.alternate="{Binding IsAlternate}"
                              Classes.selected="{Binding IsSelected}">
                        <Grid ColumnDefinitions="Auto,*,115" ColumnSpacing="12">
                        <Border Width="48" Height="48" CornerRadius="7"
                                Background="White"
                                IsVisible="{Binding HasImage}"
                                VerticalAlignment="Center">
                          <controls:RemoteImage Url="{Binding ImageUrl}"
                                                Stretch="Uniform"
                                                Margin="3" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{Binding Name}"
                                     FontSize="12" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Brush.AccentPale}"
                                     TextTrimming="CharacterEllipsis"
                                     MaxLines="1" />
                          <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Brand}"
                                       Foreground="{DynamicResource Brush.TextBody}"
                                       FontSize="10" Margin="0,0,8,0" />
                            <Border Background="{DynamicResource Brush.BadgeBackground}"
                                    CornerRadius="5" Padding="6,2" Margin="0,0,6,0">
                              <TextBlock Text="{Binding Category}"
                                         Foreground="{DynamicResource Brush.AccentPale}"
                                         FontSize="9" />
                            </Border>
                            <Border Background="{DynamicResource Brush.PanelBackground}"
                                    CornerRadius="5" Padding="6,2">
                              <TextBlock Text="{Binding OriginText}"
                                         Foreground="{DynamicResource Brush.TextBody}"
                                         FontSize="9" />
                            </Border>
                          </WrapPanel>
                          <TextBlock Text="{Binding Description}"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     FontSize="10"
                                     TextTrimming="CharacterEllipsis"
                                     MaxLines="1" />
                        </StackPanel>
                         <TextBlock Grid.Column="2"
                                    Text="{Binding DisplayPrice}"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   FontSize="11" FontWeight="SemiBold"
                                    TextAlignment="Right"
                                    VerticalAlignment="Center" />
                         <controls:ProductHoverPreview
                             Grid.ColumnSpan="3"
                             PlacementTarget="{Binding #catalogProductRow}"
                             Title="{Binding Name}"
                             Description="{Binding Description}"
                             ImageUrl="{Binding ImageUrl}"
                             Price="{Binding DisplayPrice}" />
                         </Grid>
                      </Border>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Consulta rápida de preços -->
    <Grid Grid.Column="1"
          IsVisible="{Binding IsPriceLookupView}">
      <views:PriceLookupView DataContext="{Binding PriceLookup}" />
    </Grid>

    <!-- Importações -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*"
          IsVisible="{Binding IsImportsView}">
      <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="30,20">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="4">
            <TextBlock Text="Importações" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Atualize seu catálogo local usando lojas e fornecedores externos."
                       Foreground="{DynamicResource Brush.TextBodyMuted}" FontSize="12" />
          </StackPanel>
          <Button Grid.Column="1" Classes="primary"
                  Command="{Binding ImportAllCommand}"
                  IsEnabled="{Binding CanImportAll}"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Download}" Width="17" Height="17"
                        Foreground="White" />
              <TextBlock Text="{Binding ImportAllButtonText}" Foreground="White" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" Padding="30,24" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" MaxWidth="920" HorizontalAlignment="Left">
          <Border Background="{DynamicResource Brush.WarningBackground}"
                  BorderBrush="{DynamicResource Brush.Warning}"
                  BorderThickness="1"
                  CornerRadius="12" Padding="18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <Border Width="42" Height="42" CornerRadius="10"
                      Background="{DynamicResource Brush.WarningBackground}">
                <PathIcon Data="{StaticResource Icon.Warning}" Width="20" Height="20"
                          Foreground="{DynamicResource Brush.Warning}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Atenção antes de importar"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Warning}" />
                <TextBlock Text="Todos os produtos importados anteriores serão apagados e substituídos. Antes de começar, o programa pedirá sua confirmação. Produtos manuais e itens marcados como “Manter” serão preservados."
                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextBody}" FontSize="11" />
              </StackPanel>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding ImportSources}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemWidth="450" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Width="434" MinHeight="290" Margin="0,0,16,16" Padding="20">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                      <Border Width="52" Height="52" CornerRadius="13" Background="{DynamicResource Brush.AccentSurface}"
                              VerticalAlignment="Top">
                        <PathIcon Data="{Binding Icon, Converter={StaticResource IconResourceConverter}}"
                                  Width="27" Height="27"
                                  Foreground="{DynamicResource Brush.AccentPale}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Brush.TextBodyMuted}" FontSize="10" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="9" Margin="0,14,0,14">
                      <StackPanel Spacing="4">
                        <TextBlock Text="LINK DA CATEGORIA" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBox Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Cole aqui o link da categoria"
                                 FontSize="9" MinHeight="36" Padding="9,5" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="{DynamicResource Brush.SuccessBackground}" CornerRadius="6" Padding="8,4">
                          <TextBlock Text="{Binding ImportedCountText}"
                                     Foreground="{DynamicResource Brush.Success}" FontSize="10" />
                        </Border>
                      </StackPanel>
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <PathIcon Data="{StaticResource Icon.History}" Width="13" Height="13"
                                  Foreground="{DynamicResource Brush.AccentLight}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastImportText}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="10" />
                      </Grid>
                      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource Brush.TextLabel}" FontSize="10" />
                    </StackPanel>

                    <Button Grid.Row="2" Classes="primary"
                            Command="{Binding ImportCommand}"
                            IsEnabled="{Binding CanImport}"
                            HorizontalContentAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.Download}" Width="17" Height="17"
                                  Foreground="White" />
                        <TextBlock Text="{Binding ButtonText}" Foreground="White" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Os preços e a disponibilidade pertencem à loja de origem e podem mudar a qualquer momento."
                     Foreground="{DynamicResource Brush.TextDim}" FontSize="10" TextWrapping="Wrap" />
          <Border Height="180"
                  IsHitTestVisible="False" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Rodapé global: reserva uma área fixa em todas as telas. -->
    <Border Grid.Row="1" Grid.ColumnSpan="2"
            Background="{DynamicResource Brush.SidebarBackground}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="22,0,26,0">
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding ConnectionStatus.StatusDescription}">
          <Border Width="9" Height="9" CornerRadius="5"
                  Background="{DynamicResource Brush.TextMuted}"
                  IsVisible="{Binding ConnectionStatus.IsLocalDatabase}" />
          <Border Width="9" Height="9" CornerRadius="5"
                  Background="{DynamicResource Brush.Success}"
                  IsVisible="{Binding ConnectionStatus.IsOnline}" />
          <Border Width="9" Height="9" CornerRadius="5"
                  Background="{DynamicResource Brush.Error}"
                  IsVisible="{Binding ConnectionStatus.IsOffline}" />
          <TextBlock Text="LOCAL"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.TextSecondary}"
                     IsVisible="{Binding ConnectionStatus.IsLocalDatabase}" />
          <TextBlock Text="ONLINE"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.Success}"
                     IsVisible="{Binding ConnectionStatus.IsOnline}" />
          <TextBlock Text="OFFLINE"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.Error}"
                     IsVisible="{Binding ConnectionStatus.IsOffline}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Confirmação destrutiva da importação. -->
    <Grid Grid.RowSpan="2"
          Grid.ColumnSpan="2"
          ZIndex="1000"
          Background="#A6000000"
          IsVisible="{Binding IsImportConfirmationVisible}">
      <Border Width="560"
              Padding="26"
              CornerRadius="14"
              Background="{DynamicResource Brush.CardBackground}"
              BorderBrush="{DynamicResource Brush.Warning}"
              BorderThickness="1"
              BoxShadow="0 16 44 0 #99000000"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border Width="48"
                    Height="48"
                    CornerRadius="12"
                    Background="{DynamicResource Brush.WarningBackground}">
              <PathIcon Data="{StaticResource Icon.Warning}"
                        Width="24"
                        Height="24"
                        Foreground="{DynamicResource Brush.Warning}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1"
                        Spacing="4"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding ImportConfirmationTitle}"
                         FontSize="18"
                         FontWeight="Bold" />
              <TextBlock Text="Esta ação substitui dados do catálogo."
                         FontSize="10"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding ImportConfirmationMessage}"
                     FontSize="13"
                     LineHeight="20"
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="10">
            <Button Grid.Column="1"
                    Classes="secondary"
                    Command="{Binding CancelImportConfirmationCommand}">
              <TextBlock Text="Não, voltar" />
            </Button>
            <Button Grid.Column="2"
                    Classes="primary"
                    Command="{Binding ConfirmImportCommand}"
                    Background="{DynamicResource Brush.Error}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Download}"
                          Width="16"
                          Height="16"
                          Foreground="White" />
                <TextBlock Text="Sim, importar" Foreground="White" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Janela modal de acompanhamento da importação. -->
    <Grid Grid.RowSpan="2"
          Grid.ColumnSpan="2"
          ZIndex="1001"
          Background="#A6000000"
          IsVisible="{Binding IsImportProgressVisible}">
      <Border Width="620"
              Padding="28"
              CornerRadius="14"
              Background="{DynamicResource Brush.CardBackground}"
              BorderBrush="{DynamicResource Brush.BorderStrong}"
              BorderThickness="1"
              BoxShadow="0 16 44 0 #99000000"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border Width="48"
                    Height="48"
                    CornerRadius="12"
                    Background="{DynamicResource Brush.AccentSurface}">
              <PathIcon Data="{StaticResource Icon.Download}"
                        Width="24"
                        Height="24"
                        Foreground="{DynamicResource Brush.AccentLight}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1"
                        Spacing="4"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding ImportProgressTitle}"
                         FontSize="18"
                         FontWeight="Bold" />
              <TextBlock Text="Acompanhe abaixo o que está sendo importado."
                         FontSize="10"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
          </Grid>

          <Border Background="{DynamicResource Brush.PanelBackground}"
                  BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="16">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding ImportProgressCurrentItem}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.AccentPale}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ImportProgressPercentText}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.AccentLight}" />
              </Grid>
              <ProgressBar Minimum="0"
                           Maximum="100"
                           Value="{Binding ImportProgressValue}"
                           Foreground="{DynamicResource Brush.Accent}"
                           Background="{DynamicResource Brush.Border}"
                           Height="9" />
              <TextBlock Text="{Binding ImportProgressDetail}"
                         FontSize="12"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding ImportProgressProductsText}"
                         FontSize="10"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="O cancelamento preserva a última versão concluída do catálogo."
                       FontSize="10"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="secondary"
                    Command="{Binding CancelCurrentImportCommand}"
                    IsEnabled="{Binding CanCancelCurrentImport}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Warning}"
                          Width="15"
                          Height="15"
                          Foreground="{DynamicResource Brush.Error}" />
                <TextBlock Text="Cancelar importação"
                           Foreground="{DynamicResource Brush.Error}" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
