@page "/orcamentos"
@rendermode InteractiveServer
@using BuildPc.Core.Models
@inject IQuoteRepository QuoteRepository
@implements IDisposable

<PageTitle>Orçamentos - BuildPC</PageTitle>

<h1>Orçamentos</h1>

@if (_loadError is not null)
{
    <p class="quote-error">@_loadError</p>
}
else if (_isLoading)
{
    <p>Carregando orçamentos...</p>
}
else
{
    <div class="quote-toolbar">
        <select value="@((int)_selectedPeriod)" @onchange="OnPeriodChanged">
            @foreach (var period in Periods)
            {
                <option value="@((int)period)">@QuoteFilter.DisplayName(period)</option>
            }
        </select>

        <input
            type="search"
            placeholder="Buscar por número, cliente, telefone..."
            value="@_searchText"
            @oninput="OnSearchInput" />
    </div>

    <p class="quote-count">@CountText</p>

    @if (_statusMessage is not null)
    {
        <p class="quote-status">@_statusMessage</p>
    }

    <div class="quote-layout">
        <div class="quote-table-wrap">
        <table class="quote-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Cliente</th>
                    <th>Data</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var quote in _visibleQuotes)
                {
                    <tr
                        class="@(quote.Id == _selectedQuote?.Id ? "selected" : null)"
                        @onclick="() => SelectQuote(quote)">
                        <td>#@quote.Number.ToString("000000")</td>
                        <td>@quote.ClientName</td>
                        <td>@quote.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>@quote.FinalPrice.ToString("C", CultureHelpers.BrazilianCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        @if (_selectedQuote is { } selected)
        {
            <div class="quote-detail">
                <h2>Orçamento #@selected.Number.ToString("000000")</h2>
                <p>@selected.ClientName — @selected.ClientPhone</p>
                <p>Criado em @selected.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                @if (!string.IsNullOrWhiteSpace(selected.Notes))
                {
                    <p>@selected.Notes</p>
                }

                <ul class="quote-items">
                    @foreach (var item in selected.Items)
                    {
                        <li>
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img class="quote-item-thumb" src="@item.ImageUrl" alt="" loading="lazy" />
                            }
                            @item.Quantity x
                            <ProductHoverPreview
                                Title="@item.Name"
                                Description="@item.Description"
                                ImageUrl="@item.ImageUrl"
                                Price="@item.UnitPrice.ToString("C", CultureHelpers.BrazilianCulture)">
                                @item.Name
                            </ProductHoverPreview>
                            — @item.TotalPrice.ToString("C", CultureHelpers.BrazilianCulture)
                        </li>
                    }
                </ul>

                @if (selected.HasDiscount)
                {
                    <p>Desconto: @selected.DiscountAmount.ToString("C", CultureHelpers.BrazilianCulture)</p>
                }
                <p><strong>Total: @selected.FinalPrice.ToString("C", CultureHelpers.BrazilianCulture)</strong></p>
                @if (selected.ValidUntil is { } validUntil)
                {
                    <p>Válido até @validUntil.ToString("dd/MM/yyyy")</p>
                }

                <div class="quote-actions">
                    <a href="@($"/montagem?editar={selected.Id}")">Abrir na Montagem</a>
                    <a href="@($"/montagem?duplicar={selected.Id}")">Duplicar</a>
                    <a href="@($"/pdf/orcamento/{selected.Id}")" target="_blank">Baixar PDF</a>
                    @if (_isDeleteConfirmationVisible)
                    {
                        <span>
                            Excluir orçamento #@selected.Number.ToString("000000")? Não pode ser desfeito.
                        </span>
                        <button type="button" @onclick="ConfirmDeleteAsync">Confirmar exclusão</button>
                        <button type="button" @onclick="() => _isDeleteConfirmationVisible = false">
                            Cancelar
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="() => _isDeleteConfirmationVisible = true">
                            Excluir
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private static readonly QuotePeriod[] Periods = Enum.GetValues<QuotePeriod>();

    private IReadOnlyList<SavedQuote> _allQuotes = [];
    private IReadOnlyList<SavedQuote> _visibleQuotes = [];
    private SavedQuote? _selectedQuote;
    private string _searchText = string.Empty;
    private QuotePeriod _selectedPeriod = QuotePeriod.All;
    private bool _isLoading = true;
    private bool _isDeleteConfirmationVisible;
    private string? _loadError;
    private string? _statusMessage;
    private CancellationTokenSource? _searchDebounce;

    private string CountText => _allQuotes.Count == _visibleQuotes.Count
        ? _visibleQuotes.Count == 1 ? "1 orçamento" : $"{_visibleQuotes.Count} orçamentos"
        : $"{_visibleQuotes.Count} de {_allQuotes.Count} orçamentos";

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        var selectedId = _selectedQuote?.Id;
        try
        {
            _allQuotes = await QuoteRepository.GetQuotesAsync();
            _loadError = null;
        }
        catch (InvalidOperationException exception)
        {
            _loadError = exception.Message;
            return;
        }
        finally
        {
            _isLoading = false;
        }

        ApplyFilter(selectedId);
    }

    private void ApplyFilter(Guid? selectedId = null)
    {
        var now = DateTimeOffset.Now;
        _visibleQuotes = _allQuotes
            .Where(quote =>
                QuoteFilter.IsInPeriod(quote, _selectedPeriod, now) &&
                QuoteFilter.Matches(quote, _searchText))
            .OrderByDescending(quote => quote.CreatedAt)
            .ToList();

        _selectedQuote = _visibleQuotes.FirstOrDefault(quote => quote.Id == selectedId);
        _isDeleteConfirmationVisible = false;
    }

    private void SelectQuote(SavedQuote quote)
    {
        _selectedQuote = quote;
        _isDeleteConfirmationVisible = false;
    }

    private void OnPeriodChanged(ChangeEventArgs e)
    {
        _selectedPeriod = (QuotePeriod)int.Parse(e.Value?.ToString() ?? "0");
        ApplyFilter(_selectedQuote?.Id);
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;

        _searchDebounce?.Cancel();
        _searchDebounce = new CancellationTokenSource();
        _ = DebounceFilterAsync(_searchDebounce.Token);
    }

    private async Task DebounceFilterAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(300), token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        ApplyFilter(_selectedQuote?.Id);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_selectedQuote is not { } selected)
        {
            _isDeleteConfirmationVisible = false;
            return;
        }

        var number = selected.Number;
        try
        {
            var deleted = await QuoteRepository.DeleteQuoteAsync(selected.Id);
            _statusMessage = deleted
                ? $"Orçamento #{number:000000} excluído."
                : "O orçamento já não estava mais gravado.";
        }
        catch (InvalidOperationException exception)
        {
            _statusMessage = $"Não foi possível excluir o orçamento: {exception.Message}";
            _isDeleteConfirmationVisible = false;
            return;
        }

        _selectedQuote = null;
        await RefreshAsync();
    }

    public void Dispose() => _searchDebounce?.Cancel();
}
